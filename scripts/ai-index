def configure_stdio() -> None:
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure:
            try:
                reconfigure(encoding="utf-8", errors="replace")
            except Exception:
                pass


def run_git(root: Path, *args: str) -> str:
    try:
        proc = subprocess.run(["git", *args], cwd=root, text=True, encoding="utf-8", errors="replace", capture_output=True)
        return proc.stdout.strip() if proc.returncode == 0 else ""
    except OSError:
        return ""


def root_dir() -> Path:
    here = Path.cwd().resolve()
    # A portable installation is an explicit intelligence root even when it
    # lives inside a larger Git worktree. Prefer the nearest installed guard.
    for candidate in (here, *here.parents):
        if (candidate / ".ai" / "agent-policy.json").exists() and (candidate / "scripts" / "ai-index").exists():
            return candidate
    top = run_git(here, "rev-parse", "--show-toplevel")
    return Path(top).resolve() if top else here


def is_git_root(root: Path) -> bool:
    top = run_git(root, "rev-parse", "--show-toplevel")
    if not top:
        return False
    try:
        return Path(top).resolve() == root.resolve()
    except OSError:
        return False


def rel(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def ignored(rp: str) -> bool:
    parts = Path(rp).parts
    if any(part in IGNORE_PARTS for part in parts):
        return True
    padded = "/" + rp.strip("/") + "/"
    return "/vendor/" in padded or "/generated/" in padded or "/.cache/" in padded


def iter_files(root: Path) -> Iterable[Path]:
    for base, dirs, names in os.walk(root):
        bp = Path(base)
        base_rel = "" if bp == root else rel(bp, root)
        dirs[:] = [d for d in dirs if not ignored((base_rel + "/" + d).strip("/"))]
        for name in names:
            path = bp / name
            rp = rel(path, root)
            if ignored(rp):
                continue
            if path.suffix.lower() in TEXT_EXT or name in SPECIAL_TEXT:
                yield path


def language_for(path: Path) -> str:
    return TEXT_EXT.get(path.suffix.lower(), "text")


def py_module(path: str) -> str:
    p = Path(path)
    if p.suffix not in {".py", ".pyi"}:
        return ""
    parts = list(p.with_suffix("").parts)
    if parts[:1] == ["src"]:
        parts = parts[1:]
    if parts and parts[-1] == "__init__":
        parts.pop()
    return ".".join(parts)


def generic_module(path: str) -> str:
    p = Path(path)
    parts = list(p.parts)
    if not parts:
        return "root"
    if parts[0] in {"tests", "test", "spec", "specs", "__tests__"}:
        return "tests"
    if parts[0] == ".github":
        return "ci"
    if parts[0] in {"scripts", "tools", "tooling", "bin"}:
        return "tooling"
    if parts[0] in {"docs", "doc"}:
        return "docs"
    if parts[0] in {"packaging", "deploy", "deployment", "infra"}:
        return parts[0]
    pymod = py_module(path)
    if pymod:
        bits = pymod.split(".")
        if len(bits) >= 2:
            return ".".join(bits[:2])
        return pymod or "root"
    stem_parts = list(p.with_suffix("").parts)
    if stem_parts[:1] == ["src"] and len(stem_parts) > 1:
        stem_parts = stem_parts[1:]
    if stem_parts and stem_parts[-1].lower() in {"index", "main", "mod"}:
        stem_parts.pop()
    return ".".join(stem_parts[:2]) if stem_parts else "root"


def module_for(path: str) -> str:
    return generic_module(path)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def content_identity(root: Path, path: Path) -> tuple[str, str, str]:
    data = path.read_bytes()
    sha = sha256_bytes(data)
    rp = rel(path, root)
    tracked = run_git(root, "ls-files", "--error-unmatch", "--", rp) if is_git_root(root) else ""
    if tracked:
        blob = run_git(root, "hash-object", "--", rp)
        if blob:
            return f"git-sha1:{blob}", "git-blob-sha1", sha
    return f"sha256:{sha}", "sha256", sha


def same_hash(root: Path, path: Path, expected: str) -> bool:
    if expected.startswith("git-sha1:"):
        actual = run_git(root, "hash-object", "--", rel(path, root))
        return expected == "git-sha1:" + actual
    sha = sha256_bytes(path.read_bytes())
    return expected in {sha, "sha256:" + sha}


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def write_text_if_changed(path: Path, text: str) -> bool:
    try:
        if path.read_text(encoding="utf-8") == text:
            return False
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8", newline="\n")
    return True


def write_json(path: Path, value: Any) -> bool:
    return write_text_if_changed(path, json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n")


def key(path: str) -> str:
    return hashlib.sha256(path.encode("utf-8")).hexdigest()[:16] + "-" + (Path(path).name.replace(".", "_")[:28] or "root")


def mkey(module: str) -> str:
    return hashlib.sha256(module.encode("utf-8")).hexdigest()[:12] + "-" + re.sub(r"[^A-Za-z0-9_-]+", "-", module)[:36]


def load_manifest(root: Path) -> dict[str, Any]:
    return read_json(root / INDEX_ROOT / "manifest.json", {})


def load_file_index(root: Path) -> dict[str, dict[str, Any]]:
    man = load_manifest(root)
    if not man.get("sharded"):
        return read_json(root / AI / "file-index.json", {}).get("files", {})
    out: dict[str, dict[str, Any]] = {}
    for path, meta in man.get("files", {}).items():
        doc = read_json(root / INDEX_ROOT / "files" / f"{meta['key']}.json", {})
        out[path] = doc.get("file", doc)
    return out


def load_symbols(root: Path) -> list[dict[str, Any]]:
    man = load_manifest(root)
    if not man.get("sharded"):
        return read_json(root / AI / "symbol-index.json", {}).get("symbols", [])
    out: list[dict[str, Any]] = []
    for _, meta in sorted(man.get("files", {}).items()):
        out.extend(read_json(root / INDEX_ROOT / "symbols" / f"{meta['key']}.json", {}).get("symbols", []))
    return sorted(out, key=lambda x: (x.get("file", ""), x.get("start_line", 0), x.get("qualname", "")))


def load_audit(root: Path) -> dict[str, Any]:
    man = load_manifest(root)
    out: dict[str, Any] = {}
    for path, meta in man.get("files", {}).items():
        doc = read_json(root / INDEX_ROOT / "audit" / f"{meta['key']}.json", {})
        out[path] = doc.get("audit", {})
    return out


def call_name(node: ast.AST) -> str:
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        left = call_name(node.value)
        return f"{left}.{node.attr}" if left else node.attr
    return ""


def absolute_import(expr: str, source_path: str) -> str:
    if not expr.startswith("."):
        return expr
    level = len(expr) - len(expr.lstrip("."))
    rest = expr.lstrip(".")
    source = py_module(source_path)
    base = source.split(".")[:-1]
    if level > 1:
        base = base[: max(0, len(base) - (level - 1))]
    return ".".join([*base, rest] if rest else base)


class PythonExtractor(ast.NodeVisitor):
    def __init__(self, path: str):
        self.path = path
        self.python_module = py_module(path)
        self.scope: list[tuple[str, str]] = []
        self.imports: list[str] = []
        self.bindings: dict[str, str] = {}
        self.symbols: list[dict[str, Any]] = []
        self.call_stack: list[dict[str, Any]] = []

    def qualname(self, name: str) -> str:
        return ".".join(x for x in [self.python_module, *[s[0] for s in self.scope], name] if x)

    def visit_Import(self, node: ast.Import) -> None:
        for alias in node.names:
            self.imports.append(alias.name)
            self.bindings[alias.asname or alias.name.split(".")[0]] = alias.name

    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
        expr = "." * node.level + (node.module or "")
        self.imports.append(expr)
        base = absolute_import(expr, self.path)
        for alias in node.names:
            if alias.name == "*":
                continue
            self.bindings[alias.asname or alias.name] = base + (("." + alias.name) if base else alias.name)

    def add(self, node: ast.AST, name: str, kind: str, signature: str = "") -> dict[str, Any]:
        parent = ".".join(x for x in [self.python_module, *[s[0] for s in self.scope]] if x)
        item = {
            "symbol": name,
            "qualname": self.qualname(name),
            "kind": kind,
            "file": self.path,
            "module": module_for(self.path),
            "python_module": self.python_module,
            "parent_qualname": parent,
            "start_line": getattr(node, "lineno", 1),
            "end_line": getattr(node, "end_lineno", getattr(node, "lineno", 1)),
            "signature": signature,
            "doc": (ast.get_docstring(node) or "").split("\n")[0][:320] if isinstance(node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) else "",
            "imports": [], "import_bindings": {}, "calls": [], "call_forms": {},
            "calls_resolved": [], "called_by": [], "call_edges": [], "tests": [],
            "parse_confidence": "confirmed",
        }
        self.symbols.append(item)
        return item

    def visit_ClassDef(self, node: ast.ClassDef) -> None:
        self.add(node, node.name, "class")
        self.scope.append((node.name, "class"))
        self.generic_visit(node)
        self.scope.pop()

    def _function(self, node: ast.FunctionDef | ast.AsyncFunctionDef, async_: bool) -> None:
        in_class = bool(self.scope and self.scope[-1][1] == "class")
        kind = ("async_method" if in_class else "async_function") if async_ else ("method" if in_class else "function")
        args = [a.arg for a in [*node.args.posonlyargs, *node.args.args]]
        if node.args.vararg:
            args.append("*" + node.args.vararg.arg)
        args.extend(a.arg for a in node.args.kwonlyargs)
        if node.args.kwarg:
            args.append("**" + node.args.kwarg.arg)
        item = self.add(node, node.name, kind, "(" + ", ".join(args) + ")")
        self.scope.append((node.name, kind))
        self.call_stack.append(item)
        self.generic_visit(node)
        self.call_stack.pop()
        self.scope.pop()

    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
        self._function(node, False)

    def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
        self._function(node, True)

    def visit_Assign(self, node: ast.Assign) -> None:
        if not self.scope:
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id.isupper() and len(target.id) >= 3:
                    self.add(node, target.id, "constant")
        self.generic_visit(node)

    def visit_AnnAssign(self, node: ast.AnnAssign) -> None:
        if not self.scope and isinstance(node.target, ast.Name) and node.target.id.isupper() and len(node.target.id) >= 3:
            self.add(node, node.target.id, "constant")
        self.generic_visit(node)

    def visit_Call(self, node: ast.Call) -> None:
        if self.call_stack:
            raw = call_name(node.func)
            if raw:
                item = self.call_stack[-1]
                item["calls"].append(raw)
                form = "name" if isinstance(node.func, ast.Name) else "attribute" if isinstance(node.func, ast.Attribute) else "dynamic"
                previous = item["call_forms"].get(raw)
                item["call_forms"][raw] = form if previous in {None, form} else "mixed"
        self.generic_visit(node)


def parse_python(path: Path, rp: str) -> tuple[list[dict[str, Any]], list[str], dict[str, str], str]:
    try:
        ex = PythonExtractor(rp)
        ex.visit(ast.parse(path.read_text(encoding="utf-8"), filename=rp))
        imports = sorted(set(ex.imports))
        bindings = dict(sorted(ex.bindings.items()))
        for symbol in ex.symbols:
            symbol["imports"] = imports
            symbol["import_bindings"] = bindings
            symbol["calls"] = sorted(set(symbol["calls"]))
            symbol["call_forms"] = dict(sorted(symbol["call_forms"].items()))
        return ex.symbols, imports, bindings, ""
    except (SyntaxError, UnicodeDecodeError, OSError) as exc:
        return [], [], {}, f"{type(exc).__name__}: {exc}"


REGEX_PATTERNS: dict[str, list[tuple[str, str]]] = {
    "javascript": [("class", r"^\s*(?:export\s+)?class\s+([A-Za-z_$][\w$]*)"), ("function", r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][\w$]*)"), ("function", r"^\s*(?:export\s+)?const\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?\([^)]*\)\s*=>")],
    "typescript": [("class", r"^\s*(?:export\s+)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)"), ("interface", r"^\s*(?:export\s+)?interface\s+([A-Za-z_$][\w$]*)"), ("function", r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][\w$]*)"), ("function", r"^\s*(?:export\s+)?const\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?\([^)]*\)\s*=>")],
    "go": [("function", r"^\s*func\s+(?:\([^)]*\)\s*)?([A-Za-z_][\w]*)\s*\("), ("type", r"^\s*type\s+([A-Za-z_][\w]*)\s+(?:struct|interface)\b")],
    "rust": [("function", r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+([A-Za-z_][\w]*)\s*\("), ("struct", r"^\s*(?:pub\s+)?struct\s+([A-Za-z_][\w]*)"), ("enum", r"^\s*(?:pub\s+)?enum\s+([A-Za-z_][\w]*)"), ("trait", r"^\s*(?:pub\s+)?trait\s+([A-Za-z_][\w]*)")],
    "java": [("class", r"^\s*(?:public\s+|protected\s+|private\s+)?(?:abstract\s+|final\s+)?class\s+([A-Za-z_][\w]*)"), ("interface", r"^\s*(?:public\s+)?interface\s+([A-Za-z_][\w]*)")],
    "csharp": [("class", r"^\s*(?:public\s+|internal\s+|protected\s+|private\s+)?(?:abstract\s+|sealed\s+|static\s+)*class\s+([A-Za-z_][\w]*)"), ("interface", r"^\s*(?:public\s+|internal\s+)?interface\s+([A-Za-z_][\w]*)")],
    "cpp": [("class", r"^\s*(?:class|struct)\s+([A-Za-z_][\w]*)")],
    "c": [("function", r"^\s*[A-Za-z_][\w\s\*]*\s+([A-Za-z_][\w]*)\s*\([^;]*\)\s*\{")],
}


def parse_regex_symbols(path: Path, rp: str, language: str) -> list[dict[str, Any]]:
    patterns = REGEX_PATTERNS.get(language, [])
    if not patterns:
        return []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    symbols: list[dict[str, Any]] = []
    module = module_for(rp)
    for number, line in enumerate(lines, 1):
        for kind, pattern in patterns:
            m = re.search(pattern, line)
            if not m:
                continue
            name = m.group(1)
            symbols.append({
                "symbol": name, "qualname": f"{module}.{name}" if module else name,
                "kind": kind, "file": rp, "module": module, "python_module": "",
                "parent_qualname": module, "start_line": number, "end_line": number,
                "signature": line.strip()[:320], "doc": "", "imports": [], "import_bindings": {},
                "calls": [], "call_forms": {}, "calls_resolved": [], "called_by": [], "call_edges": [],
                "tests": [], "parse_confidence": "heuristic",
            })
            break
    return symbols


def resolve_import(name: str, module_files: dict[str, str], source_path: str = "") -> str | None:
    if name.startswith(".") and source_path:
        candidate = absolute_import(name, source_path)
    else:
        candidate = name.lstrip(".")
    while candidate:
        if candidate in module_files:
            return module_files[candidate]
        candidate = ".".join(candidate.split(".")[:-1])
    return None


def link_symbols(symbols: list[dict[str, Any]]) -> None:
    by_q = {s["qualname"]: s for s in symbols}
    by_simple: dict[str, list[dict[str, Any]]] = {}
    for s in symbols:
        by_simple.setdefault(s["symbol"], []).append(s)
    for s in symbols:
        resolved: list[str] = []
        edges: list[dict[str, str]] = []
        bindings = s.get("import_bindings", {})
        forms = s.get("call_forms", {})
        for raw in s.get("calls", []):
            parts = raw.split(".")
            form = forms.get(raw, "legacy")
            candidates: list[str] = []
            if parts[0] in bindings:
                base = bindings[parts[0]]
                suffix = ".".join(parts[1:])
                candidates.append(base + (("." + suffix) if suffix else ""))
            if parts[0] in {"self", "cls"} and s.get("parent_qualname"):
                candidates.append(s["parent_qualname"] + "." + parts[-1])
            if raw in by_q:
                candidates.append(raw)
            if s.get("python_module"):
                if form in {"name", "legacy"} and len(parts) == 1:
                    candidates.append(s["python_module"] + "." + raw)
                elif form == "attribute":
                    candidates.append(s["python_module"] + "." + raw)
            target = next((c for c in candidates if c in by_q), None)
            confidence = "confirmed"
            if target is None and form == "name" and len(parts) == 1:
                matches = by_simple.get(parts[0], [])
                if len(matches) == 1:
                    target = matches[0]["qualname"]
                    confidence = "inferred"
            if target:
                resolved.append(target)
                edges.append({"raw": raw, "target": target, "confidence": confidence})
            else:
                edges.append({"raw": raw, "target": raw, "confidence": "unresolved"})
        s["calls_resolved"] = sorted(set(resolved))
        s["call_edges"] = sorted(edges, key=lambda x: (x["target"], x["raw"]))
        s["called_by"] = []
    for s in symbols:
        for target in s.get("calls_resolved", []):
            if target in by_q:
                by_q[target]["called_by"].append(s["qualname"])
    for s in symbols:
        s["called_by"] = sorted(set(s["called_by"]))


def architecture_doc(root: Path) -> dict[str, Any]:
    return read_json(root / AI / "architectural-semantics.json", {"module_rules": [], "file_rules": [], "symbol_rules": []})


def apply_semantics(doc: dict[str, Any], path: str, item: dict[str, Any], symbol: bool = False) -> None:
    item.setdefault("public_surface", False)
    item.setdefault("implementation_core", False)
    item.setdefault("preferred_edit_target", False)
    item.setdefault("internal_only", False)
    item.setdefault("entry_point", False)
    item.setdefault("state_owner", "")
    item.setdefault("architectural_boundary", "")
    item.setdefault("semantic_tags", [])
    item.setdefault("invariants", [])
    module = item.get("module", module_for(path))
    for rule in doc.get("module_rules", []):
        if fnmatch.fnmatch(module, rule.get("pattern", "")):
            merge_semantics(item, rule)
    for rule in doc.get("file_rules", []):
        if fnmatch.fnmatch(path, rule.get("pattern", "")):
            merge_semantics(item, rule)
    if symbol:
        q = item.get("qualname", item.get("symbol", ""))
        for rule in doc.get("symbol_rules", []):
            if fnmatch.fnmatch(q, rule.get("pattern", "")) or fnmatch.fnmatch(item.get("symbol", ""), rule.get("pattern", "")):
                merge_semantics(item, rule)
    heuristic_semantics(path, item)


def merge_semantics(item: dict[str, Any], rule: dict[str, Any]) -> None:
    for field in ("public_surface", "implementation_core", "preferred_edit_target", "internal_only", "entry_point", "state_owner", "architectural_boundary"):
        if field in rule:
            item[field] = rule[field]
    for field in ("semantic_tags", "invariants"):
        if field in rule:
            item[field] = sorted(set(item.get(field, [])) | set(rule.get(field, [])))


def heuristic_semantics(path: str, item: dict[str, Any]) -> None:
    lower = path.lower().replace("\\", "/")
    name = Path(path).name.lower()
    internal = any(part in lower.split("/") for part in {"internal", "private", "legacy", "impl", "implementation"}) or name.startswith("_core") or name.startswith("_impl")
    public = name in {"__init__.py", "api.py", "api.ts", "api.js", "index.ts", "index.js"}
    entry = name in {"main.py", "app.py", "cli.py", "main.ts", "main.js", "index.ts", "index.js"} or lower.startswith("bin/")
    if internal and not item.get("public_surface"):
        item["internal_only"] = True
        item["implementation_core"] = True
    if public:
        item["public_surface"] = True
        if not item.get("internal_only"):
            item["preferred_edit_target"] = True
    if entry:
        item["entry_point"] = True
        item["public_surface"] = True
        if not item.get("internal_only"):
            item["preferred_edit_target"] = True


def dependency_graph(idx: dict[str, dict[str, Any]], symbols: list[dict[str, Any]]) -> dict[str, Any]:
    module_files = {py_module(p): p for p in idx if py_module(p)}
    file_imports: dict[str, list[dict[str, str]]] = {}
    module_deps: dict[str, set[str]] = {}
    for path, info in idx.items():
        edges: list[dict[str, str]] = []
        for imp in info.get("imports", []):
            target = resolve_import(imp, module_files, path)
            if target:
                edges.append({"target": target, "confidence": "confirmed"})
                sm, tm = module_for(path), module_for(target)
                if sm != tm:
                    module_deps.setdefault(sm, set()).add(tm)
        if edges:
            file_imports[path] = sorted(edges, key=lambda x: x["target"])
    deps = {k: sorted(v) for k, v in module_deps.items()}
    rev: dict[str, set[str]] = {}
    for source, targets in deps.items():
        for target in targets:
            rev.setdefault(target, set()).add(source)
    calls = []
    for s in symbols:
        for edge in s.get("call_edges", []):
            calls.append({"from": s["qualname"], "to": edge.get("target", edge.get("raw", "")), "confidence": edge.get("confidence", "unresolved")})
    return {
        "schema_version": SCHEMA,
        "file_imports": file_imports,
        "module_dependencies": deps,
        "module_dependents": {k: sorted(v) for k, v in rev.items()},
        "symbol_calls": sorted(calls, key=lambda x: (x["from"], x["to"])),
    }


TEST_TREE_PREFIXES = ("tests/", "test/", "spec/", "specs/", "__tests__/")
TEST_CODE_SUFFIXES = {
    ".py", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs",
    ".go", ".rs", ".rb", ".php", ".java", ".kt", ".kts", ".cs",
    ".c", ".cc", ".cpp", ".cxx",
}


TEST_TREE_PREFIXES = ("tests/", "test/", "spec/", "specs/", "__tests__/")
TEST_CODE_SUFFIXES = {
    ".py", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs",
    ".go", ".rs", ".rb", ".php", ".java", ".kt", ".kts", ".cs",
    ".c", ".cc", ".cpp", ".cxx",
}


def is_test_path(path: str) -> bool:
    """Return True only for executable test source files, not every file under tests/."""
    normalized = path.lower().replace("\\", "/")
    name = Path(normalized).name
    suffix = Path(name).suffix
    if suffix not in TEST_CODE_SUFFIXES:
        return False
    if name in {"__init__.py", "conftest.py"}:
        return False
    if name.startswith("test_"):
        return True
    if name.endswith(("_test.py", "_test.go", "_test.rs", "_test.rb", "_test.php")):
        return True
    if any(marker in name for marker in (".test.", ".spec.")):
        return True
    return False


def is_test_support_path(path: str) -> bool:
    """Return True for files that live in test/support trees and must not be source targets."""
    normalized = path.lower().replace("\\", "/")
    return normalized.startswith(TEST_TREE_PREFIXES) or is_test_path(path)


def test_map(root: Path, idx: dict[str, dict[str, Any]], symbols: list[dict[str, Any]]) -> dict[str, Any]:
    sources = [p for p in idx if not is_test_support_path(p)]
    tests = [p for p in idx if is_test_path(p)]
    module_files = {py_module(p): p for p in idx if py_module(p)}
    f2t: dict[str, list[str]] = {p: [] for p in sources}
    t2f: dict[str, list[str]] = {}
    by_q = {s["qualname"]: s for s in symbols}
    for test in tests:
        targets: set[str] = set()
        for imp in idx[test].get("imports", []):
            target = resolve_import(imp, module_files, test)
            if target and target in sources:
                targets.add(target)
        stem = Path(test).stem.lower()
        stem = re.sub(r"^(test_|spec_)", "", stem)
        stem = re.sub(r"(_test|_spec)$", "", stem)
        for src in sources:
            src_stem = Path(src).stem.lower()
            if stem and stem == src_stem:
                targets.add(src)
        t2f[test] = sorted(targets)
        for src in targets:
            f2t[src].append(test)
    s2t: dict[str, list[str]] = {}
    test_symbols = [s for s in symbols if s["file"] in tests]
    for ts in test_symbols:
        for q in ts.get("calls_resolved", []):
            target = by_q.get(q)
            if target and target["file"] in sources:
                s2t.setdefault(q, []).append(ts["file"])
    for q in list(s2t):
        s2t[q] = sorted(set(s2t[q]))
    for s in symbols:
        if s["file"] in sources:
            mapped = set(s2t.get(s["qualname"], []))
            if s["kind"] in {"class", "interface", "struct", "enum", "trait"} and s["symbol"].lower() not in GENERIC_TEST_NAMES:
                # A class/type imported by a test is useful structural evidence.
                mapped.update(f2t.get(s["file"], []))
            s["tests"] = sorted(mapped)
            if mapped:
                s2t[s["qualname"]] = sorted(mapped)
    m2t: dict[str, set[str]] = {}
    for src, mapped in f2t.items():
        m2t.setdefault(module_for(src), set()).update(mapped)
    return {
        "schema_version": SCHEMA,
        "file_to_tests": {k: sorted(set(v)) for k, v in f2t.items() if v},
        "test_to_files": {k: sorted(set(v)) for k, v in t2f.items()},
        "symbol_to_tests": s2t,
        "module_to_tests": {k: sorted(v) for k, v in m2t.items()},
    }


def audit_state(idx: dict[str, dict[str, Any]], old: dict[str, Any], changed: set[str], indexed_commit: str) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for path, info in idx.items():
        previous = dict(old.get(path, {}))
        if not previous:
            previous = {
                "reviewed": False, "re_audit_required": True, "audit_categories": {},
                "last_reviewed_commit": "", "unresolved_findings": [], "migrated_from": "",
            }
        if path in changed:
            previous["reviewed"] = False
            previous["re_audit_required"] = True
            previous["audit_categories"] = {}
        previous["content_hash"] = info.get("content_hash", "")
        previous["content_sha256"] = info.get("content_sha256", "")
        out[path] = previous
    return {"schema_version": SCHEMA, "indexed_commit": indexed_commit, "categories": AUDIT_CATEGORIES, "files": out}


def write_shards(root: Path, idx: dict[str, dict[str, Any]], symbols: list[dict[str, Any]], dg: dict[str, Any], tm: dict[str, Any], au: dict[str, Any], meta: dict[str, Any], previous: str, change: dict[str, Any]) -> list[str]:
    touched: list[str] = []
    byf: dict[str, list[dict[str, Any]]] = {}
    qf: dict[str, str] = {}
    for s in symbols:
        byf.setdefault(s["file"], []).append(s)
        qf[s["qualname"]] = s["file"]
    calls_by_file: dict[str, list[dict[str, Any]]] = {}
    for edge in dg.get("symbol_calls", []):
        source_file = qf.get(edge.get("from", ""))
        if source_file:
            calls_by_file.setdefault(source_file, []).append(edge)
    manifest_files: dict[str, Any] = {}
    valid_keys: set[str] = set()
    for path, info in sorted(idx.items()):
        k = key(path)
        valid_keys.add(k)
        manifest_files[path] = {"key": k, "content_hash": info.get("content_hash", ""), "content_sha256": info.get("content_sha256", ""), "language": info.get("language", ""), "module": info.get("module", "")}
        docs = {
            "files": {"schema_version": SCHEMA, "path": path, "file": info},
            "symbols": {"schema_version": SCHEMA, "path": path, "symbols": byf.get(path, [])},
            "dependencies": {"schema_version": SCHEMA, "path": path, "file_imports": dg.get("file_imports", {}).get(path, []), "symbol_calls": calls_by_file.get(path, [])},
            "tests": {"schema_version": SCHEMA, "path": path, "file_to_tests": tm.get("file_to_tests", {}).get(path, []), "test_to_files": tm.get("test_to_files", {}).get(path, []), "symbol_to_tests": {q: v for q, v in tm.get("symbol_to_tests", {}).items() if qf.get(q) == path}},
            "audit": {"schema_version": SCHEMA, "path": path, "audit": au.get("files", {}).get(path, {})},
        }
        for kind, doc in docs.items():
            p = root / INDEX_ROOT / kind / f"{k}.json"
            if write_json(p, doc):
                touched.append(rel(p, root))
    for kind in ("files", "symbols", "dependencies", "tests", "audit"):
        d = root / INDEX_ROOT / kind
        if d.exists():
            for p in d.glob("*.json"):
                if p.stem not in valid_keys:
                    p.unlink()
                    touched.append(rel(p, root))
    modules = sorted({v.get("module", "") for v in idx.values() if v.get("module")})
    valid_modules = {mkey(m) for m in modules}
    for mod in modules:
        doc = {
            "schema_version": SCHEMA,
            "module": mod,
            "files": sorted(p for p, info in idx.items() if info.get("module") == mod),
            "depends_on": dg.get("module_dependencies", {}).get(mod, []),
            "depended_on_by": dg.get("module_dependents", {}).get(mod, []),
            "tests": tm.get("module_to_tests", {}).get(mod, []),
            "preferred_edit_targets": sorted(s["qualname"] for s in symbols if s.get("module") == mod and s.get("preferred_edit_target")),
            "state_owners": sorted({s.get("state_owner") for s in symbols if s.get("module") == mod and s.get("state_owner")}),
        }
        p = root / INDEX_ROOT / "modules" / f"{mkey(mod)}.json"
        if write_json(p, doc):
            touched.append(rel(p, root))
    module_dir = root / INDEX_ROOT / "modules"
    if module_dir.exists():
        for p in module_dir.glob("*.json"):
            if p.stem not in valid_modules:
                p.unlink(); touched.append(rel(p, root))
    man = {
        "schema_version": SCHEMA, "intelligence_version": VERSION,
        "sharded": True, "coverage_complete": True, "git": meta,
        "previous_indexed_commit": previous, "files": manifest_files,
        "counts": {"files": len(idx), "symbols": len(symbols), "modules": len(modules)},
    }
    for p, doc in ((root / INDEX_ROOT / "manifest.json", man), (root / INDEX_ROOT / "change-index.json", change)):
        if write_json(p, doc):
            touched.append(rel(p, root))
    return sorted(set(touched))


def remove_legacy_generated_indexes(root: Path) -> None:
    """Remove v1 root-level generated indexes after canonical v2 shards exist."""
    for name in (
        "file-index.json",
        "symbol-index.json",
        "dependency-graph.json",
        "test-map.json",
        "audit-coverage.json",
        "change-index.json",
    ):
        try:
            (root / AI / name).unlink(missing_ok=True)
        except OSError:
            pass

def ensure_seed_docs(root: Path) -> None:
    (root / AI).mkdir(exist_ok=True)
    seeds: dict[str, Any] = {
        "architectural-semantics.json": {
            "schema_version": SCHEMA,
            "_instructions": "Add module/file/symbol rules as repository architecture becomes known. More-specific rules override broad rules.",
            "module_rules": [], "file_rules": [], "symbol_rules": [],
        },
        "findings.json": {"schema_version": 1, "findings": []},
        "semantic-concepts.json": {
            "schema_version": 1,
            "concepts": {
                "state_authority": ["source of truth", "canonical state", "state owner", "authoritative"],
                "entry_point": ["entry point", "startup", "bootstrap", "main"],
                "tests": ["test", "regression", "validation", "coverage"],
                "dependency": ["dependency", "caller", "callee", "uses", "depends on"],
                "public_api": ["public surface", "public api", "preferred edit target"],
            },
        },
        "semantic-benchmark.json": {"schema_version": 1, "queries": []},
        "DECISIONS.md": "# Repository Intelligence Decisions\n\nRecord durable architectural decisions here. Keep this concise and evidence-oriented.\n",
        "ARCHITECTURE.md": "# Repository Architecture\n\nUse this document for curated architectural boundaries that are not obvious from code structure.\n",
        "COMPLETION.md": f"# Repository Intelligence Baseline\n\nPortable Repository Intelligence v{VERSION} is installed. The intelligence engine is infrastructure; generated `.ai/index/**` remains live and must be updated with repository changes. Indexing/embedding never means audited.\n",
    }
    for name, value in seeds.items():
        p = root / AI / name
        if p.exists():
            continue
        if isinstance(value, str):
            p.write_text(value, encoding="utf-8", newline="\n")
        else:
            write_json(p, value)


def generate_repo_map(root: Path, idx: dict[str, dict[str, Any]], dg: dict[str, Any]) -> None:
    path = root / AI / "REPO_MAP.md"
    if path.exists() and "<!-- AUTO-GENERATED PORTABLE REPO MAP -->" not in path.read_text(encoding="utf-8", errors="replace"):
        return
    languages: dict[str, int] = {}
    modules: dict[str, int] = {}
    entries: list[str] = []
    for rp, info in idx.items():
        languages[info.get("language", "text")] = languages.get(info.get("language", "text"), 0) + 1
        modules[info.get("module", "root")] = modules.get(info.get("module", "root"), 0) + 1
        if info.get("entry_point"):
            entries.append(rp)
    lines = [
        "<!-- AUTO-GENERATED PORTABLE REPO MAP -->",
        "# Repository Map",
        "",
        "This is the generated cold-start map. Curated architecture may be added to `.ai/ARCHITECTURE.md` and `.ai/architectural-semantics.json`.",
        "",
        "## Entry candidates",
        *([f"- `{p}`" for p in sorted(entries)[:20]] or ["- No entry point identified automatically."]),
        "",
        "## High-signal modules",
        *[f"- `{m}` — {count} indexed files" for m, count in sorted(modules.items(), key=lambda x: (-x[1], x[0]))[:30]],
        "",
        "## Languages",
        *[f"- {lang}: {count}" for lang, count in sorted(languages.items(), key=lambda x: (-x[1], x[0]))],
        "",
        "## Dependency overview",
        *[f"- `{m}` -> {', '.join(f'`{x}`' for x in targets[:12])}" for m, targets in sorted(dg.get("module_dependencies", {}).items())[:40]],
        "",
        "## Mandatory AI workflow",
        "1. Read this map and relevant generated/curated module guidance.",
        "2. Run `python scripts/ai-index check` and update if stale.",
        "3. Run `python scripts/ai-index context \"<task>\" --no-semantic` before broad source exploration.",
        "4. Prefer architectural authority (`preferred_edit_target`, `public_surface`, `state_owner`, `entry_point`, `architectural_boundary`) over raw similarity.",
        "5. After edits run `python scripts/ai-index update` plus relevant tests.",
        "",
        "> Indexing and embedding are not auditing.",
        "",
    ]
    path.write_text("\n".join(lines), encoding="utf-8", newline="\n")


def generate_module_markdown(root: Path, idx: dict[str, dict[str, Any]], dg: dict[str, Any], tm: dict[str, Any], symbols: list[dict[str, Any]]) -> None:
    outdir = root / AI / "modules" / "generated"
    outdir.mkdir(parents=True, exist_ok=True)
    modules = sorted({i.get("module", "") for i in idx.values() if i.get("module")})
    valid: set[str] = set()
    for mod in modules:
        filename = mkey(mod) + ".md"
        valid.add(filename)
        files = sorted(p for p, info in idx.items() if info.get("module") == mod)
        preferred = sorted(s["qualname"] for s in symbols if s.get("module") == mod and s.get("preferred_edit_target"))[:30]
        owners = sorted({s.get("state_owner") for s in symbols if s.get("module") == mod and s.get("state_owner")})
        lines = [
            f"# {mod}", "", "<!-- AUTO-GENERATED MODULE INTELLIGENCE -->",
            f"**Files:** {len(files)}", "",
            "**Depends on:** " + (", ".join(f"`{x}`" for x in dg.get("module_dependencies", {}).get(mod, [])) or "None detected."),
            "", "**Depended on by:** " + (", ".join(f"`{x}`" for x in dg.get("module_dependents", {}).get(mod, [])) or "None detected."),
            "", "**Related tests:** " + (", ".join(f"`{x}`" for x in tm.get("module_to_tests", {}).get(mod, [])[:30]) or "None mapped."),
            "", "## Preferred edit targets", *([f"- `{x}`" for x in preferred] or ["- None explicitly identified; consult `.ai/architectural-semantics.json`."]),
            "", "## State owners", *([f"- {x}" for x in owners] or ["- None explicitly identified."]),
            "", "## Files", *[f"- `{x}`" for x in files[:80]], "",
        ]
        (outdir / filename).write_text("\n".join(lines), encoding="utf-8", newline="\n")
    for p in outdir.glob("*.md"):
        if p.name not in valid:
            p.unlink()


def index_repo(root: Path, mode: str) -> int:
    ensure_seed_docs(root)
    oldidx = load_file_index(root)
    oldsyms = load_symbols(root)
    oldaudit = load_audit(root)
    oldman = load_manifest(root)
    oldchange = read_json(root / INDEX_ROOT / "change-index.json", {})
    previous = oldman.get("git", {}).get("commit", "")
    historical_previous = oldman.get("previous_indexed_commit", "")
    git_owned = is_git_root(root)
    head = run_git(root, "rev-parse", "HEAD") if git_owned else ""
    branch = run_git(root, "branch", "--show-current") if git_owned else ""

    current = {rel(p, root): p for p in iter_files(root)}
    paths = set(current)
    deleted = set(oldidx) - paths
    cached: dict[str, list[dict[str, Any]]] = {}
    for s in oldsyms:
        cached.setdefault(s["file"], []).append(s)
    idx: dict[str, dict[str, Any]] = {}
    symbols: list[dict[str, Any]] = []
    changed: set[str] = set()
    errors: list[str] = []
    for rp, p in sorted(current.items()):
        content_hash, algorithm, sha = content_identity(root, p)
        lang = language_for(p)
        old = oldidx.get(rp, {})
        hash_changed = old.get("content_hash") != content_hash
        if hash_changed:
            changed.add(rp)
        should_parse = hash_changed or rp not in cached or old.get("parse_error") or mode == "init"
        info = {
            "path": rp, "language": lang, "content_hash": content_hash, "content_sha256": sha,
            "hash_algorithm": algorithm, "module": module_for(rp), "size_bytes": p.stat().st_size,
            "symbol_count": 0, "imports": [], "parse_error": "",
            "last_indexed_commit": head if hash_changed or not old else old.get("last_indexed_commit", previous or head),
        }
        if lang == "python" and should_parse:
            parsed, imports, _bindings, err = parse_python(p, rp)
            symbols.extend(parsed); info.update(imports=imports, parse_error=err, symbol_count=len(parsed))
            if err: errors.append(f"{rp}: {err}")
        elif lang == "python":
            parsed = cached.get(rp, [])
            symbols.extend(parsed); info.update(imports=old.get("imports", []), parse_error=old.get("parse_error", ""), symbol_count=len(parsed))
        else:
            parsed = parse_regex_symbols(p, rp, lang) if should_parse else cached.get(rp, [])
            symbols.extend(parsed); info.update(symbol_count=len(parsed))
        idx[rp] = info

    doc = architecture_doc(root)
    for rp, info in idx.items():
        apply_semantics(doc, rp, info)
    for s in symbols:
        apply_semantics(doc, s.get("file", ""), s, symbol=True)
    link_symbols(symbols)
    tm = test_map(root, idx, symbols)
    dg = dependency_graph(idx, symbols)

    snapshot_changed = bool(changed or deleted or set(oldidx) != paths)
    indexed_commit = head if snapshot_changed or not previous else previous
    snapshot_previous = previous if indexed_commit != previous else historical_previous
    meta = {"commit": indexed_commit, "branch": branch, "identity": "content-hash-authoritative"}
    au = audit_state(idx, oldaudit, changed, indexed_commit)

    first = not bool(oldman.get("sharded"))
    if first:
        report = {
            "schema_version": SCHEMA, "commit": indexed_commit, "previous_indexed_commit": snapshot_previous,
            "initialization": True, "newly_indexed_files": sorted(paths), "changed_files": [],
            "deleted_files": [], "renames": {}, "changed_symbols": [], "changed_modules": [],
        }
    elif mode == "init" and not snapshot_changed and oldchange:
        report = oldchange
    else:
        report = {
            "schema_version": SCHEMA, "commit": indexed_commit, "previous_indexed_commit": snapshot_previous,
            "initialization": False, "newly_indexed_files": sorted(p for p in changed if p not in oldidx),
            "changed_files": sorted(changed), "deleted_files": sorted(deleted), "renames": {},
            "changed_symbols": sorted(s["qualname"] for s in symbols if s["file"] in changed),
            "changed_modules": sorted({idx[p]["module"] for p in changed if p in idx}),
        }
    touched = write_shards(root, idx, symbols, dg, tm, au, meta, snapshot_previous, report)
    remove_legacy_generated_indexes(root)
    generate_repo_map(root, idx, dg)
    generate_module_markdown(root, idx, dg, tm, symbols)
    status_lines = [
        "# AI Index Status", "", f"- Intelligence version: **{VERSION}**",
        f"- Indexed Git baseline: `{indexed_commit or 'not-a-git-repository'}`",
        "- Freshness authority: **content hashes**", f"- Previous indexed baseline: `{snapshot_previous or 'none'}`",
        "- Canonical storage: **sharded** (`.ai/index/`)", f"- Initialization baseline: **{'yes' if report.get('initialization') else 'no'}**",
        f"- Relevant files: **{len(idx)}**", f"- Indexed symbols: **{len(symbols)}**",
        f"- Newly indexed files: **{len(report.get('newly_indexed_files', []))}**",
        f"- Changed files: **{len(report.get('changed_files', []))}**",
        f"- Deleted files: **{len(report.get('deleted_files', []))}**",
        f"- Non-fatal parse errors: **{len(errors)}**", "", "## Changed files",
        *([f"- `{p}`" for p in report.get("changed_files", [])] or ["- None."]),
        "", "## Changed symbols", *([f"- `{q}`" for q in report.get("changed_symbols", [])] or ["- None."]),
        "", "> Indexing and embedding are not auditing. Git SHA is provenance; content hashes decide freshness.", "",
    ]
    (root / AI / "INDEX_STATUS.md").write_text("\n".join(status_lines), encoding="utf-8", newline="\n")
    print(f"Indexed {len(idx)} files / {len(symbols)} symbols; {len(changed)} changed; {len(deleted)} deleted; {len(touched)} shard writes/removals; {len(errors)} non-fatal errors.")
    return 0


def check_current(root: Path) -> int:
    man = load_manifest(root)
    if not man.get("sharded") or not man.get("coverage_complete"):
        print("AI index is not initialized/exhaustive. Run: python scripts/ai-index init")
        return 1
    recorded = load_file_index(root)
    current = {rel(p, root): p for p in iter_files(root)}
    stale: list[str] = []
    for rp, p in current.items():
        expected = recorded.get(rp, {}).get("content_hash", "")
        if not expected or not same_hash(root, p, expected):
            stale.append(rp)
    stale.extend(sorted(set(recorded) - set(current)))
    if stale:
        print("AI index is stale:\n" + "\n".join(" - " + p for p in sorted(set(stale))))
        return 1
    print(f"AI sharded index is current: {len(recorded)} files.")
    return 0


def load_graph(root: Path) -> dict[str, Any]:
    man = load_manifest(root)
    calls: list[dict[str, Any]] = []
    file_imports: dict[str, Any] = {}
    for path, meta in man.get("files", {}).items():
        doc = read_json(root / INDEX_ROOT / "dependencies" / f"{meta['key']}.json", {})
        if doc.get("file_imports"):
            file_imports[path] = doc["file_imports"]
        calls.extend(doc.get("symbol_calls", []))
    module_dependencies: dict[str, list[str]] = {}
    module_dependents: dict[str, list[str]] = {}
    module_dir = root / INDEX_ROOT / "modules"
    if module_dir.exists():
        for shard in sorted(module_dir.glob("*.json")):
            doc = read_json(shard, {})
            module = doc.get("module", "")
            if module:
                module_dependencies[module] = list(doc.get("depends_on", []))
                module_dependents[module] = list(doc.get("depended_on_by", []))
    return {
        "file_imports": file_imports,
        "symbol_calls": calls,
        "module_dependencies": module_dependencies,
        "module_dependents": module_dependents,
    }

def load_tests(root: Path) -> dict[str, Any]:
    man = load_manifest(root)
    f2t: dict[str, Any] = {}
    t2f: dict[str, Any] = {}
    s2t: dict[str, Any] = {}
    for path, meta in man.get("files", {}).items():
        doc = read_json(root / INDEX_ROOT / "tests" / f"{meta['key']}.json", {})
        if doc.get("file_to_tests"):
            f2t[path] = doc["file_to_tests"]
        if doc.get("test_to_files"):
            t2f[path] = doc["test_to_files"]
        s2t.update(doc.get("symbol_to_tests", {}))
    module_to_tests: dict[str, list[str]] = {}
    module_dir = root / INDEX_ROOT / "modules"
    if module_dir.exists():
        for shard in sorted(module_dir.glob("*.json")):
            doc = read_json(shard, {})
            module = doc.get("module", "")
            if module:
                module_to_tests[module] = list(doc.get("tests", []))
    return {
        "file_to_tests": f2t,
        "test_to_files": t2f,
        "symbol_to_tests": s2t,
        "module_to_tests": module_to_tests,
    }

def tokenize(text: str) -> list[str]:
    return [x.lower() for x in TOKEN.findall(text)]


def concept_expand(root: Path, tokens: list[str]) -> list[str]:
    doc = read_json(root / AI / "semantic-concepts.json", {}).get("concepts", {})
    out = set(tokens)
    joined = " ".join(tokens)
    for concept, terms in doc.items():
        vocabulary = [concept.replace("_", " "), *terms]
        if any(term.lower() in joined or any(t in tokenize(term) for t in tokens) for term in vocabulary):
            for term in vocabulary:
                out.update(tokenize(term))
    return sorted(out)


def hashed_vector(text: str, root: Path, dims: int = 192) -> list[float]:
    toks = concept_expand(root, tokenize(text))
    vec = [0.0] * dims
    for tok in toks:
        digest = hashlib.sha256(tok.encode("utf-8")).digest()
        idx = int.from_bytes(digest[:4], "big") % dims
        sign = -1.0 if digest[4] & 1 else 1.0
        vec[idx] += sign
    norm = math.sqrt(sum(v * v for v in vec)) or 1.0
    return [v / norm for v in vec]


def cosine(a: list[float], b: list[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def semantic_chunks(root: Path) -> list[dict[str, Any]]:
    chunks: list[dict[str, Any]] = []
    for s in load_symbols(root):
        text = " ".join([s.get("qualname", ""), s.get("doc", ""), " ".join(s.get("semantic_tags", [])), s.get("state_owner", ""), s.get("architectural_boundary", "")])
        chunks.append({"id": "symbol:" + s["qualname"], "kind": "symbol", "file": s["file"], "symbol": s["qualname"], "text": text, "hash": hashlib.sha256(text.encode()).hexdigest()})
    for name in ("REPO_MAP.md", "ARCHITECTURE.md", "DECISIONS.md"):
        p = root / AI / name
        if p.exists():
            text = p.read_text(encoding="utf-8", errors="replace")
            chunks.append({"id": "doc:" + name, "kind": "doc", "file": str(AI / name), "symbol": "", "text": text, "hash": hashlib.sha256(text.encode()).hexdigest()})
    for finding in read_json(root / AI / "findings.json", {}).get("findings", []):
        text = json.dumps(finding, sort_keys=True, ensure_ascii=False)
        chunks.append({"id": "finding:" + str(finding.get("id", len(chunks))), "kind": "finding", "file": "", "symbol": "", "text": text, "hash": hashlib.sha256(text.encode()).hexdigest()})
    return chunks


def cache_conn(root: Path) -> sqlite3.Connection:
    p = root / CACHE
    p.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(p)
    conn.execute("create table if not exists vectors (id text primary key, content_hash text not null, model text not null, vector text not null)")
    conn.commit()
    return conn


def embeddings_update(root: Path, rebuild: bool = False) -> dict[str, Any]:
    model = "portable-concept-hash-v1"
    chunks = semantic_chunks(root)
    conn = cache_conn(root)
    if rebuild:
        conn.execute("delete from vectors")
    known = {row[0]: (row[1], row[2]) for row in conn.execute("select id,content_hash,model from vectors")}
    updated = reused = 0
    ids = set()
    for chunk in chunks:
        ids.add(chunk["id"])
        if known.get(chunk["id"]) == (chunk["hash"], model):
            reused += 1; continue
        vec = hashed_vector(chunk["text"], root)
        conn.execute("insert or replace into vectors(id,content_hash,model,vector) values(?,?,?,?)", (chunk["id"], chunk["hash"], model, json.dumps(vec)))
        updated += 1
    deleted = 0
    for old_id in set(known) - ids:
        conn.execute("delete from vectors where id=?", (old_id,)); deleted += 1
    conn.commit(); conn.close()
    return {"provider": "concept", "model": model, "chunks": len(chunks), "updated": updated, "reused": reused, "deleted": deleted, "cache": str(CACHE)}


def embeddings_status(root: Path) -> dict[str, Any]:
    p = root / CACHE
    if not p.exists():
        return {"provider": os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept"), "cache_exists": False, "cache": str(CACHE), "vectors": 0}
    try:
        conn = sqlite3.connect(p)
        count = conn.execute("select count(*) from vectors").fetchone()[0]
        models = [x[0] for x in conn.execute("select distinct model from vectors")]
        conn.close()
        return {"provider": os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept"), "cache_exists": True, "cache": str(CACHE), "vectors": count, "models": models}
    except sqlite3.Error as exc:
        return {"provider": "concept", "cache_exists": True, "cache": str(CACHE), "error": str(exc), "vectors": 0}


def semantic_scores(root: Path, question: str) -> dict[str, float]:
    if os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept").lower() == "off":
        return {}
    try:
        embeddings_update(root)
        qv = hashed_vector(question, root)
        conn = cache_conn(root)
        scores: dict[str, float] = {}
        for chunk_id, vector in conn.execute("select id,vector from vectors"):
            scores[chunk_id] = cosine(qv, json.loads(vector))
        conn.close()
        return scores
    except Exception:
        return {}


def rank_symbols(root: Path, question: str, use_semantic: bool) -> list[tuple[float, dict[str, Any]]]:
    qtokens = set(concept_expand(root, tokenize(question)))
    change = read_json(root / INDEX_ROOT / "change-index.json", {})
    recent = set(change.get("changed_files", []))
    findings = read_json(root / AI / "findings.json", {}).get("findings", [])
    affected: dict[str, int] = {}
    for f in findings:
        if f.get("status") not in {"resolved", "closed"}:
            for p in f.get("affected", []): affected[p] = affected.get(p, 0) + 1
    sem = semantic_scores(root, question) if use_semantic else {}
    ranked: list[tuple[float, dict[str, Any]]] = []
    for s in load_symbols(root):
        text = " ".join([s.get("qualname", ""), s.get("file", ""), s.get("doc", ""), " ".join(s.get("semantic_tags", [])), s.get("state_owner", ""), s.get("architectural_boundary", "")])
        toks = set(tokenize(text))
        overlap = len(qtokens & toks)
        score = overlap * 3.0
        qlower = question.lower()
        if s.get("symbol", "").lower() in qlower: score += 7
        if s.get("preferred_edit_target"): score += 4
        if s.get("public_surface"): score += 2
        if s.get("state_owner") and any(x in qlower for x in ("owner", "authoritative", "canonical", "source of truth", "state")): score += 5
        if s.get("entry_point") and (
            any(x in qlower for x in (
                "start", "entry", "bootstrap", "run", "main", "launch", "begin",
                "startup", "initialize", "initialise",
            ))
            or bool(qtokens & {
                "start", "entry", "bootstrap", "run", "main", "launch", "begin", "startup",
            })
        ): score += 9
        if s.get("internal_only"): score -= 2
        if s.get("file") in recent: score += 1
        score += min(affected.get(s.get("file", ""), 0), 3)
        score += max(0.0, sem.get("symbol:" + s["qualname"], 0.0)) * 6.0
        if score > 0:
            ranked.append((score, s))
    ranked.sort(key=lambda x: (-x[0], not x[1].get("preferred_edit_target", False), x[1].get("file", ""), x[1].get("start_line", 0)))
    return ranked


def exact_excerpt(root: Path, s: dict[str, Any], max_chars: int) -> str:
    path = root / s["file"]
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    start = max(1, int(s.get("start_line", 1)))
    end = max(start, int(s.get("end_line", start)))
    text = "\n".join(lines[start - 1:end])
    if len(text) > max_chars:
        text = text[:max_chars] + "\n... [truncated]"
    return text


def build_context(root: Path, question: str, max_symbols: int = 8, max_chars: int = 18000, semantic_mode: str = "auto") -> str:
    use_semantic = semantic_mode == "on" or (semantic_mode == "auto" and os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept").lower() != "off")
    ranked = rank_symbols(root, question, use_semantic)[:max_symbols]
    tests = load_tests(root)
    graph = load_graph(root)
    audit = load_audit(root)
    findings = read_json(root / AI / "findings.json", {}).get("findings", [])
    parts = [f"# Repository intelligence context\nQuestion: {question}\nSemantic: {'on' if use_semantic else 'off'}\n"]
    for score, s in ranked:
        meta = [f"score={score:.2f}", f"file={s['file']}:{s.get('start_line', 1)}-{s.get('end_line', 1)}", f"kind={s.get('kind','')}"]
        for field in ("preferred_edit_target", "public_surface", "internal_only", "entry_point"):
            if s.get(field): meta.append(field)
        if s.get("state_owner"): meta.append("state_owner=" + s["state_owner"])
        if s.get("architectural_boundary"): meta.append("boundary=" + s["architectural_boundary"])
        related_tests = tests.get("symbol_to_tests", {}).get(s["qualname"], []) or tests.get("file_to_tests", {}).get(s["file"], [])
        if related_tests: meta.append("tests=" + ",".join(related_tests[:6]))
        au = audit.get(s["file"], {})
        meta.append("audit=" + ("reviewed" if au.get("reviewed") and not au.get("re_audit_required") else "re-audit-required"))
        callers = [e["from"] for e in graph.get("symbol_calls", []) if e.get("to") == s["qualname"] and e.get("confidence") != "unresolved"]
        callees = [e["to"] for e in graph.get("symbol_calls", []) if e.get("from") == s["qualname"] and e.get("confidence") != "unresolved"]
        if callers: meta.append("callers=" + ",".join(callers[:5]))
        if callees: meta.append("callees=" + ",".join(callees[:5]))
        excerpt = exact_excerpt(root, s, min(4500, max_chars // max(1, max_symbols)))
        parts.append(f"## {s['qualname']}\n" + " | ".join(meta) + "\n```\n" + excerpt + "\n```\n")
    relevant_findings = []
    files = {s["file"] for _, s in ranked}
    for f in findings:
        if files & set(f.get("affected", [])):
            relevant_findings.append(f)
    if relevant_findings:
        parts.append("## Relevant findings\n" + "\n".join(f"- {f.get('id','?')} [{f.get('severity','?')}/{f.get('status','?')}]: {f.get('description','')}" for f in relevant_findings[:8]) + "\n")
    result = "\n".join(parts)
    return result[:max_chars]


def query(root: Path, operation: str, argument: str) -> int:
    symbols = load_symbols(root); graph = load_graph(root); tests = load_tests(root)
    byq = {s["qualname"]: s for s in symbols}
    op = operation.lower()
    result: Any
    if op == "repo_overview": result = {"manifest": load_manifest(root), "status": (root / AI / "INDEX_STATUS.md").read_text(encoding="utf-8") if (root / AI / "INDEX_STATUS.md").exists() else ""}
    elif op == "search_code": result = [{"score": round(score, 3), "symbol": s["qualname"], "file": s["file"], "line": s.get("start_line")} for score, s in rank_symbols(root, argument, False)[:30]]
    elif op == "semantic_search": result = [{"score": round(score, 3), "symbol": s["qualname"], "file": s["file"], "line": s.get("start_line")} for score, s in rank_symbols(root, argument, True)[:30]]
    elif op == "find_symbol": result = [s for s in symbols if argument.lower() in s.get("symbol", "").lower() or argument.lower() in s.get("qualname", "").lower()][:50]
    elif op == "get_symbol": result = byq.get(argument, {})
    elif op == "get_callers": result = [e for e in graph.get("symbol_calls", []) if e.get("to") == argument and e.get("confidence") != "unresolved"]
    elif op == "get_callees": result = [e for e in graph.get("symbol_calls", []) if e.get("from") == argument]
    elif op == "get_dependencies": result = graph.get("module_dependencies", {}).get(argument, [])
    elif op == "get_dependents": result = graph.get("module_dependents", {}).get(argument, [])
    elif op == "get_tests": result = tests.get("symbol_to_tests", {}).get(argument, tests.get("file_to_tests", {}).get(argument, tests.get("module_to_tests", {}).get(argument, [])))
    elif op == "get_findings": result = read_json(root / AI / "findings.json", {}).get("findings", []) if not argument else [f for f in read_json(root / AI / "findings.json", {}).get("findings", []) if argument.lower() in json.dumps(f).lower()]
    elif op == "get_audit_state": result = load_audit(root).get(argument, {})
    elif op == "get_recent_changes": result = read_json(root / INDEX_ROOT / "change-index.json", {})
    elif op == "get_architecture": result = architecture_doc(root)
    elif op == "get_decisions": result = (root / AI / "DECISIONS.md").read_text(encoding="utf-8") if (root / AI / "DECISIONS.md").exists() else ""
    elif op == "build_context": result = build_context(root, argument)
    else:
        print("Unknown operation", file=sys.stderr); return 2
    if isinstance(result, str): print(result)
    else: print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


def benchmark(root: Path) -> dict[str, Any]:
    cases = read_json(root / AI / "semantic-benchmark.json", {}).get("queries", [])
    if not cases:
        return {"cases": 0, "passed": True, "note": "No repository-specific benchmark cases configured."}
    details = []; passed = True
    for case in cases:
        ranked = rank_symbols(root, case.get("question", ""), True)[:12]
        files = {s["file"] for _, s in ranked}; syms = {s["symbol"] for _, s in ranked} | {s["qualname"] for _, s in ranked}
        expected_files = set(case.get("expected_files", [])); expected_symbols = set(case.get("expected_symbols", []))
        ok = expected_files.issubset(files) and all(any(exp == s or exp in s for s in syms) for exp in expected_symbols)
        if case.get("preferred_edit_target"):
            ok = ok and any(s["file"] == case["preferred_edit_target"] and s.get("preferred_edit_target") for _, s in ranked)
        passed = passed and ok
        details.append({"id": case.get("id", "case"), "passed": ok, "top_files": [s["file"] for _, s in ranked[:6]], "top_symbols": [s["qualname"] for _, s in ranked[:6]]})
    return {"cases": len(cases), "passed": passed, "details": details}


def main(argv: list[str] | None = None) -> int:
    configure_stdio()
    parser = argparse.ArgumentParser(description=f"Portable Repository Intelligence v{VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)
    for name in ("init", "update", "status", "check"):
        sub.add_parser(name)
    context = sub.add_parser("context"); context.add_argument("question"); context.add_argument("--max-symbols", type=int, default=8); context.add_argument("--max-chars", type=int, default=18000)
    group = context.add_mutually_exclusive_group(); group.add_argument("--semantic", action="store_true"); group.add_argument("--no-semantic", action="store_true")
    qp = sub.add_parser("query"); qp.add_argument("operation"); qp.add_argument("argument", nargs="?", default="")
    emb = sub.add_parser("embeddings"); es = emb.add_subparsers(dest="ecmd", required=True)
    for name in ("status", "update", "rebuild", "clear"): es.add_parser(name)
    bench = es.add_parser("benchmark"); bench.add_argument("--check", action="store_true")
    args = parser.parse_args(argv); root = root_dir()
    if args.cmd in {"init", "update"}: return index_repo(root, args.cmd)
    if args.cmd == "check": return check_current(root)
    if args.cmd == "status":
        p = root / AI / "INDEX_STATUS.md"
        if not p.exists(): print("AI index not initialized. Run: python scripts/ai-index init"); return 1
        print(p.read_text(encoding="utf-8")); return 0
    if args.cmd == "context": return print_context(root, args)
    if args.cmd == "query": return query(root, args.operation, args.argument)
    if args.cmd == "embeddings":
        if args.ecmd == "status": print(json.dumps(embeddings_status(root), indent=2)); return 0
        if args.ecmd == "clear":
            p = root / CACHE
            if p.exists(): p.unlink()
            return 0
        if args.ecmd in {"update", "rebuild"}: print(json.dumps(embeddings_update(root, rebuild=args.ecmd == "rebuild"), indent=2)); return 0
        if args.ecmd == "benchmark":
            result = benchmark(root); print(json.dumps(result, indent=2)); return 0 if (not args.check or result.get("passed")) else 1
    return 2


def print_context(root: Path, args: Any) -> int:
    mode = "off" if args.no_semantic else "on" if args.semantic else "auto"
    print(build_context(root, args.question, args.max_symbols, args.max_chars, mode))
    return 0


