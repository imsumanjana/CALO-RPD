        "source -> non-mutating checks/build stages -> evidence/manifests -> separately authorized gates.",
        "Pinned actions/locks, no fabricated attestations, historical evidence immutable and scoped.",
        "Stale artifacts, unpinned dependencies/actions, identity mismatch and accidental claim elevation.",
    ),
    "core": (
        "Cross-cutting CALO-RPD package utilities not owned by a narrower subsystem.",
        "Varies by file; use exact symbol/dependency retrieval before assuming ownership.",
        "Cross-cutting support for narrower application/scientific subsystems.",
        "Follow the nearest AGENTS.md; avoid new global state without explicit ownership.",
        "Hidden coupling and unclear ownership; inspect dependents before shared-helper changes.",
    ),
}
UNKNOWN_RECEIVER_METHODS = {"append", "get", "items", "values", "update", "add", "remove", "copy", "pop", "setdefault", "extend", "insert", "clear"}
DIRECT_BUILTINS = {"len", "str", "int", "float", "bool", "dict", "list", "set", "tuple", "sorted", "min", "max", "sum", "range", "enumerate", "zip", "print", "open", "isinstance", "getattr", "setattr", "hasattr", "type", "super", "any", "all", "next", "iter"}


def _calo_should_index(rp: str) -> bool:
    rp = rp.replace("\\", "/")
    if any(rp.startswith(prefix) for prefix in CALO_IGNORE_PREFIXES):
        return False
    if Path(rp).name in CALO_IGNORE_NAMES:
        return False
    if any(pat.match(Path(rp).name) for pat in CALO_HISTORICAL_PATTERNS):
        return False
    name = Path(rp).name
    return name in SPECIAL_TEXT or name == "MANIFEST.in" or Path(rp).suffix.lower() in TEXT_EXT or Path(rp).suffix.lower() == ".bat"


def iter_files(root: Path) -> Iterable[Path]:
    """Prefer Git's tracked/untracked-but-not-ignored view; fall back conservatively."""
    if is_git_root(root):
        try:
            proc = subprocess.run(
                ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            )
            if proc.returncode == 0:
                for raw in sorted(x for x in proc.stdout.split(b"\0") if x):
                    rp = raw.decode("utf-8", "replace").replace("\\", "/")
                    p = root / rp
                    if p.is_file() and _calo_should_index(rp):
                        yield p
                return
        except OSError:
            pass
    for base, dirs, names in os.walk(root):
        bp = Path(base)
        base_rel = "" if bp == root else rel(bp, root)
        dirs[:] = [d for d in dirs if not any(((base_rel + "/" + d).strip("/") + "/").startswith(prefix) for prefix in CALO_IGNORE_PREFIXES)]
        for name in names:
            p = bp / name
            rp = rel(p, root)
            if _calo_should_index(rp):
                yield p


def module_for(path: str) -> str:
    normalized = path.replace("\\", "/")
    for module, prefixes in CALO_MODULE_RULES:
        for prefix in prefixes:
            if prefix.endswith("/") and normalized.startswith(prefix):
                return module
            if prefix.endswith("_") and Path(normalized).name.startswith(prefix):
                return module
            if normalized == prefix or normalized.startswith(prefix):
                return module
    return "core" if normalized.startswith("calo_rpd_studio/") else "repository"


def merge_semantics(item: dict[str, Any], rule: dict[str, Any]) -> None:
    for field in (
        "public_surface", "implementation_core", "preferred_edit_target", "internal_only",
        "entry_point", "state_owner", "architectural_boundary", "authoritative_source", "integration_layer",
    ):
        if field in rule:
            item[field] = rule[field]
    for field in ("semantic_tags", "invariants", "important_invariants"):
        if field in rule:
            item[field] = sorted(set(item.get(field, [])) | set(rule.get(field, [])))
    if rule.get("important_invariants"):
        item["invariants"] = sorted(set(item.get("invariants", [])) | set(rule.get("important_invariants", [])))


def apply_semantics(doc: dict[str, Any], path: str, item: dict[str, Any], symbol: bool = False) -> None:
    item.setdefault("public_surface", False)
    item.setdefault("implementation_core", False)
    item.setdefault("preferred_edit_target", False)
    item.setdefault("internal_only", False)
    item.setdefault("entry_point", False)
    item.setdefault("state_owner", "")
    item.setdefault("architectural_boundary", "")
    item.setdefault("authoritative_source", "")
    item.setdefault("integration_layer", "")
    item.setdefault("semantic_tags", [])
    item.setdefault("invariants", [])
    item.setdefault("important_invariants", [])
    module = item.get("module", module_for(path))
    for rule in doc.get("module_rules", []):
        if fnmatch.fnmatch(module, rule.get("pattern", "")):
            merge_semantics(item, rule)
    for rule in doc.get("file_rules", []):
        if fnmatch.fnmatch(path, rule.get("pattern", "")):
            merge_semantics(item, rule)
    if symbol:
        q = item.get("qualname", item.get("symbol", ""))
        for rule in doc.get("symbol_rules", []):
            if fnmatch.fnmatch(q, rule.get("pattern", "")) or fnmatch.fnmatch(item.get("symbol", ""), rule.get("pattern", "")):
                merge_semantics(item, rule)
    heuristic_semantics(path, item)


def heuristic_semantics(path: str, item: dict[str, Any]) -> None:
    lower = path.lower().replace("\\", "/")
    name = Path(path).name.lower()
    internal = (
        any(part in {"internal", "private", "legacy", "impl", "implementation"} for part in lower.split("/"))
        or name.startswith("_core") or name.startswith("_impl") or (name.startswith("_") and name.endswith("_core.py"))
        or name.startswith("_policy_registry_core") or name.startswith("_tsh_calo_") and "_core" in name
    )
    public = name in {"__init__.py", "api.py", "index.py"}
    entry = name in {"main.py", "app.py", "application.py", "cli.py", "launcher.py"} or lower.startswith("bin/")
    if internal and not item.get("public_surface"):
        item["internal_only"] = True
        item["implementation_core"] = True
    if public:
        item["public_surface"] = True
        if not item.get("internal_only"):
            item["preferred_edit_target"] = True
    if entry:
        item["entry_point"] = True
        if not item.get("internal_only"):
            item["public_surface"] = True


def link_symbols(symbols: list[dict[str, Any]]) -> None:
    """Resolve only relationships with structural evidence; preserve uncertainty explicitly."""
    by_q = {s["qualname"]: s for s in symbols}
    by_simple: dict[str, list[dict[str, Any]]] = {}
    for s in symbols:
        by_simple.setdefault(s["symbol"], []).append(s)
    for s in symbols:
        resolved: list[str] = []
        edges: list[dict[str, str]] = []
        bindings = s.get("import_bindings", {})
        forms = s.get("call_forms", {})
        for raw in s.get("calls", []):
            parts = raw.split(".")
            form = forms.get(raw, "legacy")
            candidates: list[tuple[str, str]] = []
            # Imported modules/symbols provide confirmed receiver identity.
            if parts[0] in bindings:
                base = bindings[parts[0]]
                suffix = ".".join(parts[1:])
                candidates.append((base + (("." + suffix) if suffix else ""), "confirmed"))
            # self/cls receiver is structurally tied to the current class.
            if parts[0] in {"self", "cls"} and s.get("parent_qualname"):
                candidates.append((s["parent_qualname"] + "." + parts[-1], "confirmed"))
            if raw in by_q:
                candidates.append((raw, "confirmed"))
            pymod = s.get("python_module", "")
            if pymod and form in {"name", "legacy"} and len(parts) == 1:
                candidates.append((pymod + "." + raw, "confirmed"))
            # A same-module class receiver (ClassName.method) can be identified structurally.
            if pymod and form == "attribute" and len(parts) >= 2:
                receiver_q = pymod + "." + parts[0]
                if receiver_q in by_q and by_q[receiver_q].get("kind") == "class":
                    candidates.append((pymod + "." + raw, "confirmed"))
            target = ""
            confidence = "unresolved"
            for candidate, candidate_confidence in candidates:
                if candidate in by_q:
                    target, confidence = candidate, candidate_confidence
                    break
            # Only unqualified local names may use unique-leaf inference; never arbitrary receiver methods.
            if not target and form == "name" and len(parts) == 1 and parts[0] not in DIRECT_BUILTINS:
                matches = by_simple.get(parts[0], [])
                if len(matches) == 1:
                    target = matches[0]["qualname"]
                    confidence = "inferred"
            if target:
                resolved.append(target)
                edges.append({"raw": raw, "target": target, "confidence": confidence})
            else:
                edges.append({"raw": raw, "target": raw, "confidence": "unresolved"})
        s["calls_resolved"] = sorted(set(resolved))
        s["call_edges"] = sorted(edges, key=lambda x: (x["target"], x["raw"], x["confidence"]))
        s["called_by"] = []
    for s in symbols:
        for target in s.get("calls_resolved", []):
            if target in by_q:
                by_q[target]["called_by"].append(s["qualname"])
    for s in symbols:
        s["called_by"] = sorted(set(s["called_by"]))


def test_map(root: Path, idx: dict[str, dict[str, Any]], symbols: list[dict[str, Any]]) -> dict[str, Any]:
    """Keep broad file/module associations separate from evidence-backed symbol mappings."""
    sources = [p for p in idx if not is_test_support_path(p)]
    tests = [p for p in idx if is_test_path(p)]
    module_files = {py_module(p): p for p in idx if py_module(p)}
    f2t: dict[str, list[str]] = {p: [] for p in sources}
    t2f: dict[str, list[str]] = {}
    by_q = {s["qualname"]: s for s in symbols}
    for test in tests:
        targets: set[str] = set()
        for imp in idx[test].get("imports", []):
            target = resolve_import(imp, module_files, test)
            if target and target in sources:
                targets.add(target)
        stem = Path(test).stem.lower()
        stem = re.sub(r"^(test_|spec_)", "", stem)
        stem = re.sub(r"(_test|_spec)$", "", stem)
        for src in sources:
            if stem and stem == Path(src).stem.lower():
                targets.add(src)
        t2f[test] = sorted(targets)
        for src in targets:
            f2t[src].append(test)

    s2t: dict[str, set[str]] = {}
    # Calls resolved from test functions/methods are the strongest symbol-level evidence.
    for ts in (s for s in symbols if s["file"] in tests):
        for q in ts.get("calls_resolved", []):
            target = by_q.get(q)
            if target and target["file"] in sources and target.get("symbol", "").lower() not in GENERIC_TEST_NAMES:
                s2t.setdefault(q, set()).add(ts["file"])
    # Direct from-import bindings are qualified structural references even if used outside a parsed test function.
    for test in tests:
        for bound in idx[test].get("import_bindings", {}).values():
            target = by_q.get(bound)
            if target and target["file"] in sources and target.get("symbol", "").lower() not in GENERIC_TEST_NAMES:
                s2t.setdefault(bound, set()).add(test)
    for s in symbols:
        if s["file"] in sources:
            s["tests"] = sorted(s2t.get(s["qualname"], set()))
    m2t: dict[str, set[str]] = {}
    for src, mapped in f2t.items():
        m2t.setdefault(module_for(src), set()).update(mapped)
    return {
        "schema_version": SCHEMA,
        "file_to_tests": {k: sorted(set(v)) for k, v in f2t.items() if v},
        "test_to_files": {k: sorted(set(v)) for k, v in t2f.items()},
        "symbol_to_tests": {k: sorted(v) for k, v in s2t.items()},
        "module_to_tests": {k: sorted(v) for k, v in m2t.items()},
    }


def _git_path_clean_against_head(root: Path, path: str) -> bool:
    if not is_git_root(root):
        return False
    for args in (("diff", "--quiet", "--", path), ("diff", "--cached", "--quiet", "--", path)):
        try:
            proc = subprocess.run(
                ["git", *args], cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except OSError:
            return False
        if proc.returncode != 0:
            return False
    return True


def _git_head_blob_sha256(root: Path, path: str) -> str:
    if not is_git_root(root):
        return ""
    try:
        proc = subprocess.run(
            ["git", "show", f"HEAD:{path}"],
            cwd=root,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return ""
    return sha256_bytes(proc.stdout) if proc.returncode == 0 else ""


def _legacy_review_matches_current(
    root: Path,
    path: str,
    record: dict[str, Any],
    info: dict[str, Any],
) -> bool:
    expected = str(record.get("content_hash", ""))
    if not expected:
        return False
    if expected == info.get("content_sha256"):
        return True
    # A Windows checkout can materialize CRLF while the reviewed Git blob remains LF.
    # Accept that representation difference only when the canonical HEAD blob still
    # matches the historical SHA-256 and the source has no staged or unstaged edit.
    return (
        _git_path_clean_against_head(root, path)
        and _git_head_blob_sha256(root, path) == expected
    )


def _migrate_legacy_audit_seed(root: Path, idx: dict[str, dict[str, Any]], out: dict[str, Any]) -> None:
    seed = read_json(root / AI / "audit-seed.json", {}).get("units", {})
    for path, record in seed.items():
        info = idx.get(path)
        if not info or not _legacy_review_matches_current(root, path, record, info):
            continue
        current = out.setdefault(path, {})
        if current.get("reviewed") and not current.get("re_audit_required"):
            continue
        current.update({
            "reviewed": True,
            "re_audit_required": False,
            "audit_categories": list(record.get("audit_categories", [])),
            "last_reviewed_commit": record.get("last_reviewed_commit", ""),
            "last_reviewed_content_sha256": record.get("content_hash", ""),
            "scope_note": record.get("scope_note", ""),
            "unresolved_findings": list(current.get("unresolved_findings", [])),
            "migrated_from": ".ai/audit-seed.json",
        })


def audit_state(idx: dict[str, dict[str, Any]], old: dict[str, Any], changed: set[str], indexed_commit: str) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for path, info in idx.items():
        previous = dict(old.get(path, {}))
        existed = bool(previous)
        if not existed:
            previous = {
                "reviewed": False, "re_audit_required": False, "audit_categories": [],
                "last_reviewed_commit": "", "last_reviewed_content_sha256": "",
                "unresolved_findings": [], "migrated_from": "",
            }
        elif path in changed and previous.get("reviewed"):
            previous["reviewed"] = False
            previous["re_audit_required"] = True
            previous["audit_categories"] = []
        elif path in changed and not previous.get("reviewed"):
            previous["re_audit_required"] = False
        previous["content_hash"] = info.get("content_hash", "")
        previous["content_sha256"] = info.get("content_sha256", "")
        out[path] = previous
    _migrate_legacy_audit_seed(ROOT_FOR_AUDIT if 'ROOT_FOR_AUDIT' in globals() else Path.cwd(), idx, out)
    return {"schema_version": SCHEMA, "indexed_commit": indexed_commit, "categories": AUDIT_CATEGORIES, "files": out}


def _detect_renames(oldidx: dict[str, dict[str, Any]], idx: dict[str, dict[str, Any]], deleted: set[str], added: set[str]) -> dict[str, str]:
    old_by_hash: dict[str, list[str]] = {}
    new_by_hash: dict[str, list[str]] = {}
    for p in deleted:
        h = oldidx.get(p, {}).get("content_sha256", "")
        if h:
            old_by_hash.setdefault(h, []).append(p)
    for p in added:
        h = idx.get(p, {}).get("content_sha256", "")
        if h:
            new_by_hash.setdefault(h, []).append(p)
    renames: dict[str, str] = {}
    for h in set(old_by_hash) & set(new_by_hash):
        olds, news = sorted(old_by_hash[h]), sorted(new_by_hash[h])
        if len(olds) == 1 and len(news) == 1:
            renames[olds[0]] = news[0]
    return renames


def generate_module_markdown(root: Path, idx: dict[str, dict[str, Any]], dg: dict[str, Any], tm: dict[str, Any], symbols: list[dict[str, Any]]) -> None:
    outdir = root / AI / "modules" / "generated"
    outdir.mkdir(parents=True, exist_ok=True)
    modules = sorted({i.get("module", "") for i in idx.values() if i.get("module")})
    valid: set[str] = set()
    for mod in modules:
        filename = mkey(mod) + ".md"
        valid.add(filename)
        files = sorted(p for p, info in idx.items() if info.get("module") == mod)
        starts = sorted({s["file"] for s in symbols if s.get("module") == mod and (s.get("public_surface") or s.get("entry_point")) and not s.get("internal_only")})[:30]
        preferred = sorted({s["file"] for s in symbols if s.get("module") == mod and s.get("preferred_edit_target") and not s.get("internal_only")})[:30]
        internals = sorted({s["file"] for s in symbols if s.get("module") == mod and (s.get("implementation_core") or s.get("internal_only"))})[:30]
        owners = sorted({s.get("state_owner") for s in symbols if s.get("module") == mod and s.get("state_owner")})
        knowledge = CALO_MODULE_KNOWLEDGE.get(mod)
        lines = [f"# {mod}", "", "<!-- AUTO-GENERATED MODULE INTELLIGENCE -->"]
        if knowledge:
            purpose, state, flow, constraints, failures = knowledge
            lines += [f"**Purpose:** {purpose}", "", f"**Important state:** {state}", "", f"**Major flow:** {flow}", "", f"**Constraints/invariants:** {constraints}", "", f"**Common failure points:** {failures}", ""]
        lines += [
            "## Start here", *([f"- `{x}`" for x in starts] or ["- No public/entry surface identified automatically; use curated module guidance."]),
            "", "## Preferred edit targets", *([f"- `{x}`" for x in preferred] or ["- None explicitly identified; consult `.ai/architectural-semantics.json`."]),
            "", "## Deep/internal implementation", *([f"- `{x}`" for x in internals] or ["- None identified."]),
            "", "## State owners", *([f"- {x}" for x in owners] or ["- None explicitly identified."]),
            "", "## Cross-module dependencies", *([f"- `{x}`" for x in dg.get("module_dependencies", {}).get(mod, [])] or ["- None confirmed."]),
            "", "## Dependents", *([f"- `{x}`" for x in dg.get("module_dependents", {}).get(mod, [])] or ["- None confirmed."]),
            "", "## Related tests", *([f"- `{x}`" for x in tm.get("module_to_tests", {}).get(mod, [])[:40]] or ["- None mapped."]),
            "", "## Files", *[f"- `{x}`" for x in files[:100]], "",
            "> Generated routing is evidence, not auditing. Curated `.ai/modules/*.md` guidance remains authoritative when more specific.", "",
        ]
        write_text_if_changed(outdir / filename, "\n".join(lines))
    for p in outdir.glob("*.md"):
        if p.name not in valid:
            p.unlink()


def _semantic_model_identity(root: Path) -> str:
    concepts = (root / AI / "semantic-concepts.json")
    digest = hashlib.sha256()
    digest.update(b"calo-portable-concept-hash-v2\\0")
    if concepts.exists():
        digest.update(concepts.read_bytes())
    return "calo-concept:" + digest.hexdigest()[:24]


def cache_conn(root: Path) -> sqlite3.Connection:
    p = root / CACHE
    p.parent.mkdir(parents=True, exist_ok=True)
    try:
        conn = sqlite3.connect(p)
        conn.execute("pragma quick_check")
    except sqlite3.DatabaseError:
        try:
            if p.exists():
                p.replace(p.with_suffix(p.suffix + ".corrupt"))
        except OSError:
            try:
                p.unlink(missing_ok=True)
            except OSError:
                pass
        conn = sqlite3.connect(p)
    conn.execute("create table if not exists vectors (id text primary key, content_hash text not null, model text not null, vector text not null)")
    conn.commit()
    return conn


def embeddings_update(root: Path, rebuild: bool = False) -> dict[str, Any]:
    provider = os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept").lower()
    if provider == "off":
        return {"provider": "off", "disabled": True, "chunks": 0, "updated": 0, "reused": 0, "deleted": 0, "cache": str(CACHE)}
    if provider != "concept":
        raise RuntimeError(f"Unsupported optional embedding provider: {provider!r}; use 'concept' or 'off'.")
    model = _semantic_model_identity(root)
    chunks = semantic_chunks(root)
    conn = cache_conn(root)
    if rebuild:
        conn.execute("delete from vectors")
    known = {row[0]: (row[1], row[2]) for row in conn.execute("select id,content_hash,model from vectors")}
    updated = reused = 0
    ids = set()
    for chunk in chunks:
        ids.add(chunk["id"])
        if known.get(chunk["id"]) == (chunk["hash"], model):
            reused += 1
            continue
        vec = hashed_vector(chunk["text"], root)
        conn.execute("insert or replace into vectors(id,content_hash,model,vector) values(?,?,?,?)", (chunk["id"], chunk["hash"], model, json.dumps(vec)))
        updated += 1
    deleted = 0
    for old_id in set(known) - ids:
        conn.execute("delete from vectors where id=?", (old_id,))
        deleted += 1
    conn.commit(); conn.close()
    return {"provider": provider, "model": model, "chunks": len(chunks), "updated": updated, "reused": reused, "deleted": deleted, "cache": str(CACHE)}


def embeddings_status(root: Path) -> dict[str, Any]:
    provider = os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept").lower()
    p = root / CACHE
    if not p.exists():
        return {"provider": provider, "cache_exists": False, "cache": str(CACHE), "vectors": 0, "expected_model": _semantic_model_identity(root) if provider == "concept" else ""}
    try:
        conn = sqlite3.connect(p)
        count = conn.execute("select count(*) from vectors").fetchone()[0]
        models = [x[0] for x in conn.execute("select distinct model from vectors")]
        conn.close()
        return {"provider": provider, "cache_exists": True, "cache": str(CACHE), "vectors": count, "models": models, "expected_model": _semantic_model_identity(root) if provider == "concept" else ""}
    except sqlite3.Error as exc:
        return {"provider": provider, "cache_exists": True, "cache": str(CACHE), "error": str(exc), "vectors": 0}


def _finding_paths(finding: dict[str, Any]) -> set[str]:
    values = finding.get("affected", finding.get("affected_paths", finding.get("files", [])))
    return {str(x) for x in (values or [])}


def rank_symbols(root: Path, question: str, use_semantic: bool) -> list[tuple[float, dict[str, Any]]]:
    qtokens = set(concept_expand(root, tokenize(question)))
    change = read_json(root / INDEX_ROOT / "change-index.json", {})
    recent = set(change.get("changed_files", [])) | set(change.get("newly_indexed_files", [])) | set(change.get("renames", {}).values())
    findings = read_json(root / AI / "findings.json", {}).get("findings", [])
    affected: dict[str, int] = {}
    for f in findings:
        if f.get("status") not in {"resolved", "closed", "rejected", "false_positive"}:
            for p in _finding_paths(f):
                affected[p] = affected.get(p, 0) + 1
    sem = semantic_scores(root, question) if use_semantic else {}
    qlower = question.lower()
    ranked: list[tuple[float, dict[str, Any]]] = []
    for s in load_symbols(root):
        text = " ".join([
            s.get("qualname", ""), s.get("file", ""), s.get("doc", ""), " ".join(s.get("semantic_tags", [])),
            s.get("state_owner", ""), s.get("architectural_boundary", ""), s.get("authoritative_source", ""),
            s.get("integration_layer", ""), " ".join(s.get("important_invariants", [])),
        ])
        stoks = set(tokenize(text))
        overlap = len(qtokens & stoks)
        score = float(overlap * 3)
        if s.get("symbol", "").lower() in qlower: score += 8
        if any(tok in s.get("file", "").lower() for tok in qtokens): score += 2
        if s.get("preferred_edit_target"): score += 5
        if s.get("public_surface"): score += 3
        if s.get("integration_layer"): score += 3
        if s.get("authoritative_source"): score += 3
        if s.get("state_owner") and any(x in qlower for x in ("owner", "authoritative", "canonical", "source of truth", "state")): score += 7
        if s.get("entry_point") and (
            any(x in qlower for x in (
                "start", "entry", "bootstrap", "run", "main", "launch", "begin",
                "startup", "initialize", "initialise",
            ))
            or bool(qtokens & {
                "start", "entry", "bootstrap", "run", "main", "launch", "begin", "startup",
            })
        ): score += 9
        if s.get("implementation_core"): score -= 2
        if s.get("internal_only"): score -= 5
        if s.get("file") in recent: score += 1
        score += min(affected.get(s.get("file", ""), 0), 3)
        score += max(0.0, sem.get("symbol:" + s["qualname"], 0.0)) * 5.0
        if score > 0:
            ranked.append((score, s))
    ranked.sort(key=lambda x: (-x[0], not x[1].get("preferred_edit_target", False), x[1].get("internal_only", False), x[1].get("file", ""), x[1].get("start_line", 0)))
    return ranked


def build_context(root: Path, question: str, max_symbols: int = 8, max_chars: int = 18000, semantic_mode: str = "auto") -> str:
    use_semantic = semantic_mode == "on" or (semantic_mode == "auto" and os.getenv("AI_INDEX_EMBEDDING_PROVIDER", "concept").lower() != "off")
    ranked = rank_symbols(root, question, use_semantic)[:max_symbols]
    tests = load_tests(root); graph = load_graph(root); audit = load_audit(root)
    findings = read_json(root / AI / "findings.json", {}).get("findings", [])
    parts = [f"# Repository intelligence context\nQuestion: {question}\nSemantic: {'on' if use_semantic else 'off'}\n"]
    for score, s in ranked:
        meta = [f"score={score:.2f}", f"file={s['file']}:{s.get('start_line',1)}-{s.get('end_line',1)}", f"kind={s.get('kind','')}"]
        for field in ("preferred_edit_target", "public_surface", "implementation_core", "internal_only", "entry_point"):
            if s.get(field): meta.append(field)
        for field in ("state_owner", "architectural_boundary", "authoritative_source", "integration_layer"):
            if s.get(field): meta.append(field + "=" + str(s[field]))
        related_tests = tests.get("symbol_to_tests", {}).get(s["qualname"], []) or tests.get("file_to_tests", {}).get(s["file"], [])
        if related_tests: meta.append("tests=" + ",".join(related_tests[:6]))
        au = audit.get(s["file"], {})
        if au.get("reviewed") and not au.get("re_audit_required"):
            meta.append("audit=reviewed")
        elif au.get("re_audit_required"):
            meta.append("audit=re-audit-required")
        else:
            meta.append("audit=not-reviewed")
        callers = [e["from"] for e in graph.get("symbol_calls", []) if e.get("to") == s["qualname"] and e.get("confidence") != "unresolved"]
        callees = [e["to"] for e in graph.get("symbol_calls", []) if e.get("from") == s["qualname"] and e.get("confidence") != "unresolved"]
        if callers: meta.append("callers=" + ",".join(callers[:5]))
        if callees: meta.append("callees=" + ",".join(callees[:5]))
        excerpt = exact_excerpt(root, s, min(4500, max_chars // max(1, max_symbols)))
        parts.append(f"## {s['qualname']}\n" + " | ".join(meta) + "\n```\n" + excerpt + "\n```\n")
    files = {s["file"] for _, s in ranked}
    relevant_findings = [f for f in findings if files & _finding_paths(f)]
    if relevant_findings:
        parts.append("## Relevant findings\n" + "\n".join(f"- {f.get('id','?')} [{f.get('severity','?')}/{f.get('status','?')}]: {f.get('description','')}" for f in relevant_findings[:8]) + "\n")
    change = read_json(root / INDEX_ROOT / "change-index.json", {})
    if not change.get("initialization") and (change.get("changed_files") or change.get("newly_indexed_files") or change.get("renames")):
        parts.append("## Actual recent changes\n" + json.dumps({k: change.get(k) for k in ("changed_files", "newly_indexed_files", "deleted_files", "renames", "changed_modules")}, indent=2) + "\n")
    return "\n".join(parts)[:max_chars]


# Keep a handle to portable seed behavior, then add CALO workflow seeds without replacing curated docs.
_portable_ensure_seed_docs = ensure_seed_docs

def ensure_seed_docs(root: Path) -> None:
    _portable_ensure_seed_docs(root)
    workflow = root / AI / "AI_WORKFLOW.md"
    if not workflow.exists():
        write_text_if_changed(workflow, """# AI-assisted development workflow\n\n1. Read `REPO_MAP.md` and only the relevant curated/generated module summary.\n2. Run `python scripts/ai-index check`; update if stale.\n3. Run `python scripts/ai-index context \"<question>\" --no-semantic` before broad exploration.\n4. Respect public surfaces, preferred edit targets, state owners, entry points, integration layers, boundaries and invariants.\n5. Inspect callers/callees, dependencies/dependents, mapped tests, findings, audit state and actual recent changes when relevant.\n6. After source changes run `python scripts/ai-index update`, then relevant tests.\n7. Before commit handoff run `python scripts/ai-index precommit --no-semantic`.\n8. Indexing and embedding never mean audited.\n\nThe schema/sharding/retrieval/audit contracts are frozen after benchmark validation; generated repository intelligence remains live.\n""")


def index_repo(root: Path, mode: str) -> int:
    global ROOT_FOR_AUDIT
    ROOT_FOR_AUDIT = root
    ensure_seed_docs(root)
    oldidx = load_file_index(root); oldsyms = load_symbols(root); oldaudit = load_audit(root); oldman = load_manifest(root)
    oldchange = read_json(root / INDEX_ROOT / "change-index.json", {})
    previous = oldman.get("git", {}).get("commit", ""); historical_previous = oldman.get("previous_indexed_commit", "")
    git_owned = is_git_root(root); head = run_git(root, "rev-parse", "HEAD") if git_owned else ""; branch = run_git(root, "branch", "--show-current") if git_owned else ""
    current = {rel(p, root): p for p in iter_files(root)}
    paths = set(current); deleted = set(oldidx) - paths
    cached: dict[str, list[dict[str, Any]]] = {}
    for s in oldsyms: cached.setdefault(s["file"], []).append(s)
    idx: dict[str, dict[str, Any]] = {}; symbols: list[dict[str, Any]] = []; changed: set[str] = set(); errors: list[str] = []
    for rp, p in sorted(current.items()):
        content_hash, algorithm, sha = content_identity(root, p); lang = language_for(p); old = oldidx.get(rp, {})
        hash_changed = old.get("content_hash") != content_hash
        if hash_changed: changed.add(rp)
        should_parse = hash_changed or rp not in cached or old.get("parse_error") or mode == "init"
        info = {
            "path": rp, "language": lang, "content_hash": content_hash, "content_sha256": sha,
            "hash_algorithm": algorithm, "module": module_for(rp), "size_bytes": p.stat().st_size,
            "symbol_count": 0, "imports": [], "import_bindings": {}, "parse_error": "",
            "last_indexed_commit": head if hash_changed or not old else old.get("last_indexed_commit", previous or head),
        }
        if lang == "python" and should_parse:
            parsed, imports, bindings, err = parse_python(p, rp)
            symbols.extend(parsed); info.update(imports=imports, import_bindings=bindings, parse_error=err, symbol_count=len(parsed))
            if err: errors.append(f"{rp}: {err}")
        elif lang == "python":
            parsed = cached.get(rp, []); symbols.extend(parsed)
            info.update(imports=old.get("imports", []), import_bindings=old.get("import_bindings", {}), parse_error=old.get("parse_error", ""), symbol_count=len(parsed))
        else:
            parsed = parse_regex_symbols(p, rp, lang) if should_parse else cached.get(rp, [])
            symbols.extend(parsed); info.update(symbol_count=len(parsed))
        idx[rp] = info
    doc = architecture_doc(root)
    for rp, info in idx.items(): apply_semantics(doc, rp, info)
    for s in symbols: apply_semantics(doc, s.get("file", ""), s, symbol=True)
    link_symbols(symbols); tm = test_map(root, idx, symbols); dg = dependency_graph(idx, symbols)
    added = set(idx) - set(oldidx)
    renames = _detect_renames(oldidx, idx, deleted, added)
    renamed_old, renamed_new = set(renames), set(renames.values())
    # Exact-content renames inherit prior audit history, without pretending the path change itself was reviewed.
    for old_path, new_path in renames.items():
        if old_path in oldaudit and new_path not in oldaudit:
            oldaudit[new_path] = dict(oldaudit[old_path])
    snapshot_changed = bool(changed or deleted or set(oldidx) != paths)
    indexed_commit = head if snapshot_changed or not previous else previous
    snapshot_previous = previous if indexed_commit != previous else historical_previous
    meta = {"commit": indexed_commit, "branch": branch, "identity": "content-hash-authoritative", "profile": "CALO-RPD", "profile_version": CALO_PROFILE_VERSION}
    au = audit_state(idx, oldaudit, changed - renamed_new, indexed_commit)
    first = not bool(oldman.get("sharded"))
    modified = sorted((changed - added) - renamed_new)
    genuinely_new = sorted(added - renamed_new)
    changed_for_symbols = set(modified) | set(genuinely_new) | renamed_new
    changed_modules = sorted({idx[p]["module"] for p in changed_for_symbols if p in idx} | {oldidx[p].get("module", "") for p in renamed_old if p in oldidx and oldidx[p].get("module")})
    if first:
        report = {"schema_version": SCHEMA, "commit": indexed_commit, "previous_indexed_commit": snapshot_previous, "initialization": True,
                  "newly_indexed_files": sorted(paths), "changed_files": [], "deleted_files": [], "renames": {}, "changed_symbols": [], "changed_modules": []}
    elif mode == "init" and not snapshot_changed and oldchange:
        report = oldchange
    else:
        report = {"schema_version": SCHEMA, "commit": indexed_commit, "previous_indexed_commit": snapshot_previous, "initialization": False,
                  "newly_indexed_files": genuinely_new, "changed_files": modified, "deleted_files": sorted(deleted - renamed_old), "renames": dict(sorted(renames.items())),
                  "changed_symbols": sorted(s["qualname"] for s in symbols if s["file"] in changed_for_symbols), "changed_modules": changed_modules}
    touched = write_shards(root, idx, symbols, dg, tm, au, meta, snapshot_previous, report)
    remove_legacy_generated_indexes(root); generate_repo_map(root, idx, dg); generate_module_markdown(root, idx, dg, tm, symbols)
    status_lines = [
        "# AI Index Status", "", f"- Intelligence version: **{VERSION} / CALO profile {CALO_PROFILE_VERSION}**",
        f"- Indexed source baseline: `{indexed_commit or 'not-a-git-repository'}`", "- Source index current: **yes at generation time**",
        "- Freshness authority: **content hashes**", f"- Previous indexed source baseline: `{snapshot_previous or 'none'}`",
        "- Canonical storage: **sharded** (`.ai/index/`)", f"- Initialization baseline: **{'yes' if report.get('initialization') else 'no'}**",
        f"- Relevant files: **{len(idx)}**", f"- Indexed symbols: **{len(symbols)}**", f"- Modules: **{len({i.get('module') for i in idx.values() if i.get('module')})}**",
        f"- Newly indexed files: **{len(report.get('newly_indexed_files', []))}**", f"- Modified files: **{len(report.get('changed_files', []))}**",
        f"- Renames: **{len(report.get('renames', {}))}**", f"- Deleted files: **{len(report.get('deleted_files', []))}**",
        f"- Non-fatal parse errors: **{len(errors)}**",
        f"- Reviewed units retained: **{sum(1 for x in au.get('files', {}).values() if x.get('reviewed') and not x.get('re_audit_required'))}**",
        f"- Units requiring re-audit: **{sum(1 for x in au.get('files', {}).values() if x.get('re_audit_required'))}**",
        "", "## Actual recent changes", *([f"- modified `{p}`" for p in report.get("changed_files", [])] or (["- Initialization only; ordinary recent-change ranking is intentionally empty."] if report.get("initialization") else ["- None."])),
        *[f"- renamed `{a}` -> `{b}`" for a, b in report.get("renames", {}).items()], *[f"- added `{p}`" for p in report.get("newly_indexed_files", []) if not report.get("initialization")],
        *[f"- deleted `{p}`" for p in report.get("deleted_files", [])], "", "> Indexing and embedding are not auditing. Git SHA is provenance; content hashes decide freshness.", "",
    ]
    write_text_if_changed(root / AI / "INDEX_STATUS.md", "\n".join(status_lines))
    print(f"Indexed {len(idx)} files / {len(symbols)} symbols; {len(modified)} modified; {len(genuinely_new)} added; {len(renames)} renamed; {len(deleted-renamed_old)} deleted; {len(touched)} shard writes/removals; {len(errors)} non-fatal errors.")
    return 0


def _run_guard_script(root: Path) -> int:
    script = root / "scripts" / "ai-agent-guard.py"
    if not script.exists():
        print("Agent-policy guard is missing: scripts/ai-agent-guard.py", file=sys.stderr); return 1
    try:
        proc = subprocess.run([sys.executable, str(script), "--check", "--root", str(root)], cwd=root)
        return int(proc.returncode)
    except OSError as exc:
        print(str(exc), file=sys.stderr); return 1


def precommit(root: Path, semantic: bool = False) -> int:
    if index_repo(root, "update") != 0: return 1
    if _run_guard_script(root) != 0: return 1
    if check_current(root) != 0: return 1
    if semantic:
        embeddings_update(root)
        result = benchmark(root)
        if not result.get("passed"):
            print(json.dumps(result, indent=2)); return 1
    print("Repository intelligence precommit checks passed.")
    return 0


def query(root: Path, operation: str, argument: str) -> int:
    symbols = load_symbols(root); graph = load_graph(root); tests = load_tests(root); byq = {s["qualname"]: s for s in symbols}
    op = operation.lower(); result: Any
    if op == "repo_overview": result = {"manifest": load_manifest(root), "status": (root / AI / "INDEX_STATUS.md").read_text(encoding="utf-8") if (root / AI / "INDEX_STATUS.md").exists() else ""}
    elif op == "search_code": result = [{"score": round(score, 3), "symbol": s["qualname"], "file": s["file"], "line": s.get("start_line")} for score, s in rank_symbols(root, argument, False)[:30]]
    elif op == "semantic_search": result = [{"score": round(score, 3), "symbol": s["qualname"], "file": s["file"], "line": s.get("start_line")} for score, s in rank_symbols(root, argument, True)[:30]]
    elif op == "find_symbol": result = [s for s in symbols if argument.lower() in s.get("symbol", "").lower() or argument.lower() in s.get("qualname", "").lower()][:50]
    elif op == "get_symbol": result = byq.get(argument, {})
    elif op == "get_callers": result = [e for e in graph.get("symbol_calls", []) if e.get("to") == argument and e.get("confidence") != "unresolved"]
    elif op == "get_callees": result = [e for e in graph.get("symbol_calls", []) if e.get("from") == argument]
    elif op == "get_dependencies":
        if argument in graph.get("module_dependencies", {}): result = graph.get("module_dependencies", {}).get(argument, [])
        else: result = graph.get("file_imports", {}).get(argument, [])
    elif op == "get_dependents":
        if argument in graph.get("module_dependents", {}): result = graph.get("module_dependents", {}).get(argument, [])
        else:
            result = [{"source": source, "edge": edge} for source, edges in graph.get("file_imports", {}).items() for edge in edges if edge.get("target") == argument]
    elif op == "get_tests": result = tests.get("symbol_to_tests", {}).get(argument, tests.get("file_to_tests", {}).get(argument, tests.get("module_to_tests", {}).get(argument, [])))
    elif op == "get_findings": result = read_json(root / AI / "findings.json", {}).get("findings", []) if not argument else [f for f in read_json(root / AI / "findings.json", {}).get("findings", []) if argument.lower() in json.dumps(f).lower()]
    elif op == "get_audit_state": result = load_audit(root).get(argument, {})
    elif op == "get_recent_changes": result = read_json(root / INDEX_ROOT / "change-index.json", {})
    elif op == "get_architecture": result = architecture_doc(root)
    elif op == "get_decisions": result = (root / AI / "DECISIONS.md").read_text(encoding="utf-8") if (root / AI / "DECISIONS.md").exists() else ""
    elif op == "build_context": result = build_context(root, argument, semantic_mode="off")
    else: print("Unknown operation", file=sys.stderr); return 2
    print(result if isinstance(result, str) else json.dumps(result, indent=2, ensure_ascii=False)); return 0


def main(argv: list[str] | None = None) -> int:
    configure_stdio(); parser = argparse.ArgumentParser(description=f"Portable Repository Intelligence v{VERSION} with CALO-RPD profile")
    sub = parser.add_subparsers(dest="cmd", required=True)
    for name in ("init", "update", "status", "check"): sub.add_parser(name)
    context_p = sub.add_parser("context"); context_p.add_argument("question"); context_p.add_argument("--max-symbols", type=int, default=8); context_p.add_argument("--max-chars", type=int, default=18000)
    group = context_p.add_mutually_exclusive_group(); group.add_argument("--semantic", action="store_true"); group.add_argument("--no-semantic", action="store_true")
    qp = sub.add_parser("query"); qp.add_argument("operation"); qp.add_argument("argument", nargs="?", default="")
    emb = sub.add_parser("embeddings"); es = emb.add_subparsers(dest="ecmd", required=True)
    for name in ("status", "update", "rebuild", "clear"): es.add_parser(name)
    benchp = es.add_parser("benchmark"); benchp.add_argument("--check", action="store_true")
    guardp = sub.add_parser("guard"); guardp.add_argument("--no-semantic", action="store_true"); guardp.add_argument("--semantic", action="store_true")
    prep = sub.add_parser("precommit"); prep.add_argument("--no-semantic", action="store_true"); prep.add_argument("--semantic", action="store_true")
    args = parser.parse_args(argv); root = root_dir()
    if args.cmd in {"init", "update"}: return index_repo(root, args.cmd)
    if args.cmd == "check": return check_current(root)
    if args.cmd == "status":
        p = root / AI / "INDEX_STATUS.md"
        if not p.exists(): print("AI index not initialized. Run: python scripts/ai-index init"); return 1
        print(p.read_text(encoding="utf-8")); return check_current(root)
    if args.cmd == "context": return print_context(root, args)
    if args.cmd == "query": return query(root, args.operation, args.argument)
    if args.cmd == "guard":
        if _run_guard_script(root) != 0: return 1
        if check_current(root) != 0: return 1
        if args.semantic:
            result = benchmark(root); print(json.dumps(result, indent=2)); return 0 if result.get("passed") else 1
        return 0
    if args.cmd == "precommit": return precommit(root, semantic=bool(args.semantic))
    if args.cmd == "embeddings":
        if args.ecmd == "status": print(json.dumps(embeddings_status(root), indent=2)); return 0
        if args.ecmd == "clear":
            p = root / CACHE
            if p.exists(): p.unlink()
            return 0
        if args.ecmd in {"update", "rebuild"}: print(json.dumps(embeddings_update(root, rebuild=args.ecmd == "rebuild"), indent=2)); return 0
        if args.ecmd == "benchmark":
            result = benchmark(root); print(json.dumps(result, indent=2)); return 0 if (not args.check or result.get("passed")) else 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
